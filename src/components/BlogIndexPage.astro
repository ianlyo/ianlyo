---
import { Icon } from 'astro-icon/components';
import type { Page } from 'astro';
import Base from '../layouts/Base.astro';
import PostCard from './PostCard.astro';
import { BLOG_CATEGORIES } from '../content.config';
import { slugify, type ResolvedPost } from '../utils/blog';
import { t, localePath, blogCategoryLabel, type Lang } from '../i18n/ui';

interface Props {
  page: Page<ResolvedPost>;
  lang?: Lang;
}

const { page, lang = 'zh-Hant' } = Astro.props;
const ui = t(lang).blog;
---
<Base title={ui.title} description={ui.lead} lang={lang}>
  <main class="page">
    <div class="container page-narrow">
      <header class="page-head mb-4">
        <h1 class="d-flex align-items-center gap-2 hero-enter">
          <Icon name="material-symbols:article" class="material-symbols-rounded text-accent" aria-hidden="true" />
          <span>{ui.title}</span>
        </h1>
        <p class="lead hero-enter enter-delay-1">{ui.lead}</p>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2 hero-enter enter-delay-2">
          <div class="chip-row">
            {BLOG_CATEGORIES.map((c) => (
              <a class="chip d-inline-flex align-items-center gap-1" href={localePath(lang, `/blog/category/${slugify(c)}/`)} transition:name={`blog-category-${slugify(c)}`}>
                <Icon name="material-symbols:folder-open" class="material-symbols-rounded icon-xs" aria-hidden="true" />
                <span>{blogCategoryLabel(c, lang)}</span>
              </a>
            ))}
          </div>
          <a href={localePath(lang, '/search/')} class="blog-search-link">
            <Icon name="material-symbols:search" class="material-symbols-rounded icon-sm" aria-hidden="true" />
            <span>{ui.searchPlaceholder}</span>
          </a>
        </div>
      </header>
      {page.data.length ? (
        <div class="d-grid gap-3 stagger-group">
          {page.data.map((item) => <PostCard item={item} lang={lang} />)}
        </div>
      ) : (
        <p class="hero-enter enter-delay-2">{ui.noPosts}</p>
      )}
      <nav class="pagination-nav reveal reveal-fade" aria-label="Pagination">
        {page.url.prev ? (
          <a class="btn-ghost d-inline-flex align-items-center gap-1" href={page.url.prev}>
            <Icon name="material-symbols:arrow-back" class="material-symbols-rounded icon-sm" aria-hidden="true" />
            <span>{ui.newer}</span>
          </a>
        ) : <span />}
        {page.url.next ? (
          <a class="btn-ghost d-inline-flex align-items-center gap-1" href={page.url.next}>
            <span>{ui.older}</span>
            <Icon name="material-symbols:arrow-forward" class="material-symbols-rounded icon-sm" aria-hidden="true" />
          </a>
        ) : <span />}
      </nav>
    </div>
  </main>
</Base>
