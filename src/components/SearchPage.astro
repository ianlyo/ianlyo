---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang).blog;
const altPath = lang === 'en' ? '/search/' : '/en/search/';
---
<Base lang={lang} title={t(lang).nav.search} description={ui.lead} altPath={altPath} noindex>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" slot="head" />
  <main class="page"><div class="container page-narrow">
    <header class="page-head mb-4 hero-enter">
      <h1 class="d-flex align-items-center gap-2">
        <Icon name="lucide:search" class="ui-icon text-accent" aria-hidden="true" />
        <span>{t(lang).nav.search}</span>
      </h1>
    </header>
    <div id="search" class="search-box hero-enter enter-delay-1" data-translations={JSON.stringify(ui.pagefind)}></div>
    <p id="search-dev-note" class="placeholder-note" hidden>{ui.pagefind.devNote}</p>
  </div></main>
  <script>
    import '../scripts/searchPage';
  </script>
</Base>
