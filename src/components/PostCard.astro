---
import { Icon } from 'astro-icon/components';
import type { Post } from '../utils/blog';
import { readingTime, formatDate, slugify } from '../utils/blog';
import { t, type Lang } from '../i18n/ui';
interface Props { post: Post; lang?: Lang }
const { post, lang = 'zh-Hant' } = Astro.props;
const ui = t(lang).blog;
---
<article class="surface-card reveal">
  <a href={`/blog/${post.id}/`} class="post-card-link">
    <h2>{post.data.title}</h2>
    <p>{post.data.description}</p>
  </a>
  <div class="meta mt-3">
    <time datetime={post.data.pubDate.toISOString()} class="d-inline-flex align-items-center gap-1">
      <Icon name="lucide:calendar" class="ui-icon icon-xs" aria-hidden="true" />
      <span>{formatDate(post.data.pubDate, lang)}</span>
    </time>
    <span class="d-inline-flex align-items-center gap-1">
      <Icon name="lucide:clock" class="ui-icon icon-xs" aria-hidden="true" />
      <span>{readingTime(post.body)} {ui.readingTime}</span>
    </span>
    <a class="chip d-inline-flex align-items-center gap-1" href={`/blog/category/${slugify(post.data.category)}/`}>
      <Icon name="lucide:folder" class="ui-icon icon-xs" aria-hidden="true" />
      <span>{post.data.category}</span>
    </a>
  </div>
  {post.data.tags.length > 0 && (
    <div class="chip-row mt-2">
      {post.data.tags.map((tg) => (
        <a class="chip chip-muted d-inline-flex align-items-center gap-1" href={`/blog/tag/${slugify(tg)}/`}>
          <Icon name="lucide:tag" class="ui-icon icon-xs" aria-hidden="true" />
          <span>{tg}</span>
        </a>
      ))}
    </div>
  )}
</article>
