---
import { Icon } from 'astro-icon/components';
import type { ResolvedPost } from '../utils/blog';
import { readingTime, formatDate, slugify } from '../utils/blog';
import { t, localePath, blogCategoryLabel, type Lang } from '../i18n/ui';

interface Props {
  item: ResolvedPost;
  lang?: Lang;
}

const { item, lang = 'zh-Hant' } = Astro.props;
const { post, slug, isFallback } = item;
const ui = t(lang).blog;
const safeSlug = slug.replace(/[^a-zA-Z0-9_-]/g, '-');
---
<article class="surface-card reveal" lang={isFallback ? post.data.lang : undefined} transition:name={`post-card-${safeSlug}`} style="view-transition-class: vt-card;">
  <a href={localePath(lang, `/blog/${slug}/`)} class="post-card-link">
    <h2 transition:name={`post-title-${safeSlug}`}>{post.data.title}</h2>
    <p>{post.data.description}</p>
  </a>
  <div class="meta mt-3">
    <time datetime={post.data.pubDate.toISOString()} class="d-inline-flex align-items-center gap-1">
      <Icon name="lucide:calendar" class="ui-icon icon-xs" aria-hidden="true" />
      <span>{formatDate(post.data.pubDate, lang)}</span>
    </time>
    <span class="d-inline-flex align-items-center gap-1">
      <Icon name="lucide:clock" class="ui-icon icon-xs" aria-hidden="true" />
      <span>{readingTime(post.body)} {ui.readingTime}</span>
    </span>
    <a class="chip d-inline-flex align-items-center gap-1" href={localePath(lang, `/blog/category/${slugify(post.data.category)}/`)} transition:name={`post-cat-${safeSlug}`}>
      <Icon name="lucide:folder" class="ui-icon icon-xs" aria-hidden="true" />
      <span>{blogCategoryLabel(post.data.category, lang)}</span>
    </a>
    {isFallback && (
      <span class="chip chip-muted d-inline-flex align-items-center gap-1">
        <Icon name="lucide:languages" class="ui-icon icon-xs" aria-hidden="true" />
        <span>{ui.originalBadge}</span>
      </span>
    )}
  </div>
  {post.data.tags.length > 0 && (
    <div class="chip-row mt-2">
      {post.data.tags.map((tg) => (
        <a class="chip chip-muted d-inline-flex align-items-center gap-1" href={localePath(lang, `/blog/tag/${slugify(tg)}/`)}>
          <Icon name="lucide:tag" class="ui-icon icon-xs" aria-hidden="true" />
          <span>{tg}</span>
        </a>
      ))}
    </div>
  )}
</article>
