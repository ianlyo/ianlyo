---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { t, localePath, type Lang } from '../i18n/ui';
import { SITE } from '../config/site';
import { sortPosts, readingTime, formatDate } from '../utils/blog';
import AppCard from './AppCard.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const apps = (await getCollection('apps')).filter((a) => !a.data.hidden && a.data.status !== 'paused').slice(0, 3);
const posts = sortPosts(await getCollection('blog')).slice(0, 3);
const f = ui.filters;
---
<section id="home" class="hero-section">
  <div class="container">
    <div class="row align-items-center hero-grid">
      <div class="col-12 hero-copy">
        <h1 class="hero-title">{ui.hero.title1}<br /><em>{ui.hero.title2}</em></h1>
        <p class="lead">{ui.hero.lead}</p>
        <div class="hero-stats" aria-label="GitHub activity">
          <div class="stat-box">
            <Icon name="material-symbols:folder-open" class="material-symbols-rounded stat-icon" aria-hidden="true" />
            <div class="stat-box-info">
              <strong id="repo-stat">--</strong>
              <span>{ui.stats.repos}</span>
            </div>
          </div>
          <div class="stat-box">
            <Icon name="material-symbols:star" class="material-symbols-rounded stat-icon" aria-hidden="true" />
            <div class="stat-box-info">
              <strong id="star-stat">--</strong>
              <span>{ui.stats.stars}</span>
            </div>
          </div>
          <div class="stat-box">
            <Icon name="material-symbols:code" class="material-symbols-rounded stat-icon" aria-hidden="true" />
            <div class="stat-box-info">
              <strong id="language-stat">--</strong>
              <span>{ui.stats.langs}</span>
            </div>
          </div>
        </div>
        <div class="hero-actions">
          <a href={localePath(lang, '/beta/')} class="btn btn-primary d-inline-flex align-items-center gap-2">
            <span>{ui.hero.cta1}</span>
            <Icon name="material-symbols:arrow-forward" class="material-symbols-rounded icon-sm" aria-hidden="true" />
          </a>
          <a href="/blog/" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <Icon name="material-symbols:article" class="material-symbols-rounded icon-sm" aria-hidden="true" />
            <span>{ui.hero.cta2}</span>
          </a>
          <a href={SITE.github.reposUrl} target="_blank" rel="noopener" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <span>{ui.hero.cta3}</span>
            <Icon name="material-symbols:open-in-new" class="material-symbols-rounded icon-sm" aria-hidden="true" />
          </a>
        </div>
      </div>
      <div class="col-12 hero-contribution">
        <div class="contribution-card">
          <div class="contribution-header justify-content-end">
            <a href={SITE.github.reposUrl} target="_blank" rel="noopener" class="contribution-github-link"><i class="bi bi-github"></i><span>{SITE.github.user}</span></a>
          </div>
          <div class="contribution-graph-wrapper">
            <img class="contribution-graph" id="contribution-graph-img" src={SITE.github.contributionChartUrl} alt={`${SITE.github.user} GitHub contribution graph`} loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<main>
  <section class="section-block" id="beta-preview">
    <div class="container">
      <p class="eyebrow mb-2">{ui.home.betaEyebrow}</p>
      <div class="d-flex justify-content-between align-items-end mb-3 flex-wrap gap-2">
        <h2 class="block-title mb-0">
          <Icon name="material-symbols:apps" class="material-symbols-rounded text-accent" aria-hidden="true" />
          <span>{ui.home.betaTitle}</span>
        </h2>
        <a href={localePath(lang, '/beta/')} class="section-link font-weight-semibold">
          <span>{ui.home.betaAll}</span>
          <Icon name="material-symbols:arrow-forward" class="material-symbols-rounded icon-sm" aria-hidden="true" />
        </a>
      </div>
      <div class="card-grid">{apps.map((app) => <AppCard app={app} lang={lang} />)}</div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section-block" id="blog-preview">
      <div class="container">
        <p class="eyebrow mb-2">{ui.home.blogEyebrow}</p>
        <div class="d-flex justify-content-between align-items-end mb-3 flex-wrap gap-2">
          <h2 class="block-title mb-0">
            <Icon name="material-symbols:article" class="material-symbols-rounded text-accent" aria-hidden="true" />
            <span>{ui.home.blogTitle}</span>
          </h2>
          <a href="/blog/" class="section-link font-weight-semibold">
            <span>{ui.home.blogAll}</span>
            <Icon name="material-symbols:arrow-forward" class="material-symbols-rounded icon-sm" aria-hidden="true" />
          </a>
        </div>
        <div class="card-grid">
          {posts.map((p) => (
            <a class="surface-card" href={`/blog/${p.id}/`}>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <div class="meta mt-2">
                <span><Icon name="material-symbols:calendar-today" class="material-symbols-rounded icon-xs" aria-hidden="true" />{formatDate(p.data.pubDate, lang)}</span>
                <span><Icon name="material-symbols:schedule" class="material-symbols-rounded icon-xs" aria-hidden="true" />{readingTime(p.body)} {ui.blog.readingTime}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="projects" class="projects-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow mb-2">{ui.home.browse}</p>
          <h2 id="projects-title" class="d-flex align-items-center gap-2">
            <Icon name="material-symbols:code" class="material-symbols-rounded text-accent" aria-hidden="true" />
            <span>{ui.home.explore}</span>
          </h2>
        </div>
        <span id="project-count" class="section-count">…</span>
      </div>
      <!-- Desktop Capabilities Cards (>= 769px) -->
      <div class="capabilities-grid mb-4 d-none d-md-grid">
        {[
          ['all', 'dashboard', '01', f.all],
          ['mobile', 'smartphone', '02', f.mobile],
          ['python', 'terminal', '03', f.cli],
          ['web', 'devices', '04', f.web],
        ].map(([key, icon, num, text]) => (
          <button class:list={['capability-item', 'category-filter', { 'is-active': key === 'all' }]} type="button" data-category={key}>
            <div class="capability-header">
              <span class="capability-number">{num}</span>
              <div class="capability-icon"><Icon name={`material-symbols:${String(icon).replaceAll('_','-')}`} class="material-symbols-rounded" aria-hidden="true" /></div>
            </div>
            <strong class="capability-title">{(text as readonly string[])[0]}</strong>
            <p class="capability-desc">{(text as readonly string[])[1]}</p>
          </button>
        ))}
      </div>

      <div class="project-tools" role="search">
        <label class="visually-hidden" for="project-search">{ui.projects.searchLabel}</label>
        <div class="project-search-wrapper">
          <Icon name="material-symbols:search" class="material-symbols-rounded project-search-icon" aria-hidden="true" />
          <input id="project-search" type="search" placeholder={ui.projects.searchPlaceholder} autocomplete="off" />
        </div>
        <!-- Mobile Category Dropdown (< 768px) -->
        <label class="visually-hidden" for="mobile-category-filter">{ui.projects.categoryLabel}</label>
        <div class="category-filter-wrapper d-flex d-md-none">
          <Icon name="material-symbols:grid-view" class="material-symbols-rounded category-filter-icon" aria-hidden="true" />
          <select id="mobile-category-filter">
            <option value="all">{ui.projects.allCategories}</option>
            <option value="mobile">{f.mobile[0]}</option>
            <option value="python">{f.cli[0]}</option>
            <option value="web">{f.web[0]}</option>
          </select>
        </div>
        <label class="visually-hidden" for="language-filter">{ui.projects.languageLabel}</label>
        <div class="language-filter-wrapper">
          <Icon name="material-symbols:tune" class="material-symbols-rounded language-filter-icon" aria-hidden="true" />
          <select id="language-filter"><option value="">{ui.projects.allLanguages}</option></select>
        </div>
        <button id="clear-filters" class="clear-filters" type="button" hidden>
          <Icon name="material-symbols:close" class="material-symbols-rounded icon-sm" aria-hidden="true" />
          <span>{ui.projects.clearFilters}</span>
        </button>
      </div>
      <div id="projects-grid" class="row project-grid" aria-live="polite"></div>
      <p id="projects-status" class="projects-status">{ui.projects.loading}</p>
      <div class="text-center"><button id="show-more-projects" class="show-more-projects" type="button" hidden>{ui.projects.showAll}</button></div>
    </div>
  </section>
</main>
