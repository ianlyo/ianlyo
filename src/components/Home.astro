---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t, localePath, type Lang } from '../i18n/ui';
import { SITE } from '../config/site';
import { resolvePostsForLang, readingTime, formatDate } from '../utils/blog';
import AppCard from './AppCard.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const apps = (await getCollection('apps')).filter((a) => !a.data.hidden && a.data.status !== 'paused').slice(0, 3);
const posts = resolvePostsForLang(await getCollection('blog'), lang).slice(0, 3);
const f = ui.filters;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, inLanguage: lang },
  { '@context': 'https://schema.org', '@type': 'Person', name: SITE.author, url: SITE.url, sameAs: [SITE.github.profileUrl] },
];
---
<Base lang={lang} jsonLd={jsonLd}>
<section id="home" class="hero-section">
  <div class="container">
    <div class="row align-items-center hero-grid">
      <div class="col-12 hero-copy">
        <h1 class="hero-title hero-enter">{ui.hero.title1}<br /><em>{ui.hero.title2}</em></h1>
        <p class="lead hero-enter enter-delay-1">{ui.hero.lead}</p>
        <div class="hero-stats hero-enter enter-delay-2" aria-label="GitHub activity">
          <div class="stat-box">
            <Icon name="lucide:folder" class="stat-icon" aria-hidden="true" />
            <div class="stat-box-info">
              <strong id="repo-stat">--</strong>
              <span>{ui.stats.repos}</span>
            </div>
          </div>
          <div class="stat-box">
            <Icon name="lucide:star" class="stat-icon" aria-hidden="true" />
            <div class="stat-box-info">
              <strong id="star-stat">--</strong>
              <span>{ui.stats.stars}</span>
            </div>
          </div>
          <div class="stat-box">
            <Icon name="lucide:code-2" class="stat-icon" aria-hidden="true" />
            <div class="stat-box-info">
              <strong id="language-stat">--</strong>
              <span>{ui.stats.langs}</span>
            </div>
          </div>
        </div>
        <div class="hero-actions hero-enter enter-delay-3">
          <a href={localePath(lang, '/apps-dev/')} class="btn btn-primary d-inline-flex align-items-center gap-2">
            <span>{ui.hero.cta1}</span>
            <Icon name="lucide:arrow-right" class="ui-icon icon-sm" aria-hidden="true" />
          </a>
          <a href="/blog/" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <Icon name="lucide:newspaper" class="ui-icon icon-sm" aria-hidden="true" />
            <span>{ui.hero.cta2}</span>
          </a>
          <a href={SITE.github.reposUrl} target="_blank" rel="noopener" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <span>{ui.hero.cta3}</span>
            <Icon name="lucide:external-link" class="ui-icon icon-sm" aria-hidden="true" />
          </a>
        </div>
      </div>
      <div class="col-12 hero-contribution hero-enter-scale enter-delay-3">
        <div class="contribution-card">
          <div class="contribution-header justify-content-end">
            <a href={SITE.github.reposUrl} target="_blank" rel="noopener" class="contribution-github-link" aria-label={`${SITE.github.user} on GitHub`}><Icon name="simple-icons:github" class="ui-icon me-1" aria-hidden="true" /><span>{SITE.github.user}</span></a>
          </div>
          <div class="contribution-graph-wrapper">
            <img class="contribution-graph" id="contribution-graph-img" src={SITE.github.contributionChartUrl} data-github-user={SITE.github.user} alt={`${SITE.github.user} GitHub contribution graph`} width="663" height="104" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<main>
  <section class="section-block" id="beta-preview">
    <div class="container">
      <p class="eyebrow mb-2 reveal reveal-fade">{ui.home.betaEyebrow}</p>
      <div class="d-flex justify-content-between align-items-end mb-3 flex-wrap gap-2 reveal delay-1">
        <h2 class="block-title mb-0">
          <Icon name="lucide:layout-grid" class="ui-icon text-accent" aria-hidden="true" />
          <span>{ui.home.betaTitle}</span>
        </h2>
        <a href={localePath(lang, '/apps-dev/')} class="section-link font-weight-semibold">
          <span>{ui.home.betaAll}</span>
          <Icon name="lucide:arrow-right" class="ui-icon icon-sm" aria-hidden="true" />
        </a>
      </div>
      <div class="card-grid">{apps.map((app) => <AppCard app={app} lang={lang} />)}</div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section-block" id="blog-preview">
      <div class="container">
        <p class="eyebrow mb-2 reveal reveal-fade">{ui.home.blogEyebrow}</p>
        <div class="d-flex justify-content-between align-items-end mb-3 flex-wrap gap-2 reveal delay-1">
          <h2 class="block-title mb-0">
            <Icon name="lucide:newspaper" class="ui-icon text-accent" aria-hidden="true" />
            <span>{ui.home.blogTitle}</span>
          </h2>
          <a href={localePath(lang, '/blog/')} class="section-link font-weight-semibold">
            <span>{ui.home.blogAll}</span>
            <Icon name="lucide:arrow-right" class="ui-icon icon-sm" aria-hidden="true" />
          </a>
        </div>
        <div class="card-grid">
          {posts.map((item) => {
            const safeSlug = item.slug.replace(/[^a-zA-Z0-9_-]/g, '-');
            return (
              <a class="surface-card reveal" href={localePath(lang, `/blog/${item.slug}/`)} transition:name={`post-card-${safeSlug}`} style="view-transition-class: vt-card;">
                <h3 transition:name={`post-title-${safeSlug}`}>{item.post.data.title}</h3>
                <p>{item.post.data.description}</p>
                <div class="meta mt-2">
                  <span><Icon name="lucide:calendar" class="ui-icon icon-xs" aria-hidden="true" />{formatDate(item.post.data.pubDate, lang)}</span>
                  <span><Icon name="lucide:clock" class="ui-icon icon-xs" aria-hidden="true" />{readingTime(item.post.body)} {ui.blog.readingTime}</span>
                  {item.isFallback && <span class="chip chip-muted">{ui.blog.originalBadge}</span>}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section
    id="projects"
    class="projects-section"
    data-github-user={SITE.github.user}
    data-repo-single={ui.projects.repoCountSingle}
    data-repo-plural={ui.projects.repoCountPlural}
    data-no-matches={ui.projects.noMatches}
    data-show-all={ui.projects.showAll}
    data-show-less={ui.projects.showLess}
    data-load-error={ui.projects.loadError}
    data-load-error-link={ui.projects.loadErrorLink}
    data-default-desc={ui.projects.defaultRepoDesc}
    data-view-label={ui.projects.viewRepo}
  >
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow mb-2">{ui.home.browse}</p>
          <h2 id="projects-title" class="d-flex align-items-center gap-2">
            <Icon name="lucide:code-2" class="ui-icon text-accent" aria-hidden="true" />
            <span>{ui.home.explore}</span>
          </h2>
        </div>
        <span id="project-count" class="section-count">…</span>
      </div>
      <!-- 桌面版技術分類卡片 -->
      <div class="capabilities-grid mb-4 d-none d-md-grid">
        {[
          ['all', 'layout-grid', '01', f.all],
          ['mobile', 'smartphone', '02', f.mobile],
          ['python', 'terminal', '03', f.cli],
          ['web', 'monitor-smartphone', '04', f.web],
        ].map(([key, icon, num, text]) => (
          <button class:list={['capability-item', 'category-filter', 'reveal', { 'is-active': key === 'all' }]} type="button" data-category={key}>
            <div class="capability-header">
              <span class="capability-number">{num}</span>
              <div class="capability-icon"><Icon name={`lucide:${icon}`} class="ui-icon" aria-hidden="true" /></div>
            </div>
            <strong class="capability-title">{(text as readonly string[])[0]}</strong>
            <p class="capability-desc">{(text as readonly string[])[1]}</p>
          </button>
        ))}
      </div>

      <div class="project-tools reveal reveal-fade delay-1" role="search">
        <label class="visually-hidden" for="project-search">{ui.projects.searchLabel}</label>
        <div class="project-search-wrapper">
          <Icon name="lucide:search" class="ui-icon project-search-icon" aria-hidden="true" />
          <input id="project-search" type="search" placeholder={ui.projects.searchPlaceholder} autocomplete="off" />
        </div>
        <!-- 行動版分類下拉選單 -->
        <label class="visually-hidden" for="mobile-category-filter">{ui.projects.categoryLabel}</label>
        <div class="category-filter-wrapper d-flex d-md-none">
          <Icon name="lucide:layout-grid" class="ui-icon category-filter-icon" aria-hidden="true" />
          <select id="mobile-category-filter">
            <option value="all">{ui.projects.allCategories}</option>
            <option value="mobile">{f.mobile[0]}</option>
            <option value="python">{f.cli[0]}</option>
            <option value="web">{f.web[0]}</option>
          </select>
        </div>
        <label class="visually-hidden" for="language-filter">{ui.projects.languageLabel}</label>
        <div class="language-filter-wrapper">
          <Icon name="lucide:sliders-horizontal" class="ui-icon language-filter-icon" aria-hidden="true" />
          <select id="language-filter"><option value="">{ui.projects.allLanguages}</option></select>
        </div>
        <button id="clear-filters" class="clear-filters" type="button" hidden>
          <Icon name="lucide:x" class="ui-icon icon-sm" aria-hidden="true" />
          <span>{ui.projects.clearFilters}</span>
        </button>
      </div>
      <div id="projects-grid" class="row project-grid" aria-live="polite"></div>
      <p id="projects-status" class="projects-status">{ui.projects.loading}</p>
      <div class="text-center"><button id="show-more-projects" class="show-more-projects" type="button" hidden>{ui.projects.showAll}</button></div>
    </div>
  </section>
</main>
</Base>
