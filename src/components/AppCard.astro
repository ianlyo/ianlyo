---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import { t, localePath, pick, type Lang } from '../i18n/ui';
interface Props { app: CollectionEntry<'apps'>; lang: Lang }
const { app, lang } = Astro.props;
const ui = t(lang).beta;
const d = app.data;
const href = localePath(lang, `/beta/${app.id}/`);
---
<a class="surface-card" href={href}>
  <div class="d-flex gap-3 align-items-center mb-3">
    {d.icon
      ? <img class="app-icon app-icon-sm" src={d.icon} alt={`${d.name} icon`} width="56" height="56" loading="lazy" />
      : <div class="app-icon app-icon-sm app-icon-fallback" aria-hidden="true">{d.name.charAt(0)}</div>}
    <div>
      <h3 class="mb-1">{d.name}</h3>
      <span class={`status-badge s-${d.status}`}>
        {d.status === 'released' && <Icon name="material-symbols:check-circle" class="material-symbols-rounded icon-xs" aria-hidden="true" />}
        {(d.status === 'closed-beta' || d.status === 'open-beta') && <Icon name="material-symbols:science" class="material-symbols-rounded icon-xs" aria-hidden="true" />}
        {d.status === 'coming-soon' && <Icon name="material-symbols:hourglass-empty" class="material-symbols-rounded icon-xs" aria-hidden="true" />}
        {d.status === 'paused' && <Icon name="material-symbols:pause-circle" class="material-symbols-rounded icon-xs" aria-hidden="true" />}
        <span>{ui.statusLabels[d.status]}</span>
      </span>
    </div>
  </div>
  <p>{pick(d.tagline, lang)}</p>
  <div class="meta mt-3">
    <span><Icon name="material-symbols:sell" class="material-symbols-rounded icon-xs" aria-hidden="true" /><span>{ui.version} {d.version}</span></span>
    <span><Icon name="material-symbols:android" class="material-symbols-rounded icon-xs" aria-hidden="true" /><span>Android {d.minAndroid}+</span></span>
  </div>
</a>
