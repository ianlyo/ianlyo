---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ScrollSequence, { type ScrollStep } from './ScrollSequence.astro';
import ScreenshotGallery from './ScreenshotGallery.astro';
import { t, localePath, pick, type Lang } from '../i18n/ui';
interface Props { app: CollectionEntry<'apps'>; lang: Lang }
const { app, lang } = Astro.props;
const ui = t(lang).beta;
const d = app.data;
const desc = pick(d.description, lang);
const tagline = pick(d.tagline, lang);
const ogImage = d.screenshots[0]?.src ? d.screenshots[0].src : '/og/default.png';

const steps = [
  { s: ui.step1, url: d.googleGroupUrl, label: ui.groupBtn, optional: false, icon: 'groups', extra: d.extraGroups },
  { s: ui.step2, url: d.optInUrl, label: ui.optInBtn, optional: false, icon: 'how_to_reg' },
  { s: ui.step3, url: d.playStoreUrl, label: ui.playBtn, optional: false, icon: 'download_for_offline' },
  { s: ui.step4, url: d.feedbackUrl, label: ui.feedbackBtn, optional: false, icon: 'rate_review' },
];

// Scroll sequence data: derived from the app's features (+ screenshots when available)
const sequenceSteps: ScrollStep[] = d.features.map((f, i) => ({
  id: i + 1,
  images: f.images,
  video: f.video,
  zoom: f.zoom,
  image: f.image ?? (d.screenshots.length ? d.screenshots[i % d.screenshots.length].src : undefined),
  title: pick(f.title, lang),
  subtitle: pick(f.description, lang),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: d.name,
  applicationCategory: 'MobileApplication',
  operatingSystem: `Android ${d.minAndroid}+`,
  softwareVersion: d.version,
  description: desc,
  inLanguage: lang,
  ...(d.playStoreUrl ? { downloadUrl: d.playStoreUrl } : {}),
};
const altPath = localePath(lang === 'en' ? 'zh-Hant' : 'en', `/apps-dev/${app.id}/`);
---
<Base lang={lang} title={`${d.name} - ${ui.title}`} description={tagline} image={ogImage} imageAlt={`${d.name} preview`} jsonLd={jsonLd} altPath={altPath}>
  <main class="page" data-pagefind-body>
    <div class="container page-narrow">
      <a href={localePath(lang, '/apps-dev/')} class="meta mb-3 back-link" data-pagefind-ignore>
        <Icon name="material-symbols:arrow-back" class="material-symbols-rounded icon-sm" aria-hidden="true" />
        <span>{ui.back}</span>
      </a>

      <!-- 1. Hero -->
      <header class="app-hero mb-3">
        {d.icon
          ? <img class="app-icon" src={d.icon} alt={`${d.name} icon`} width="96" height="96" data-pagefind-meta="image[src]" />
          : <div class="app-icon app-icon-fallback" aria-hidden="true">{d.name.charAt(0)}</div>}
        <div>
          <h1 class="mb-1 scroll-gradient-text" style="font-weight:800" data-pagefind-meta="title">{d.name}</h1>
          <p class="mb-2" style="color:var(--text-secondary)">{tagline}</p>
          <div class="meta">
            <span class={`status-badge s-${d.status}`}>
              {d.status === 'released' && <Icon name="material-symbols:check-circle" class="material-symbols-rounded icon-xs" aria-hidden="true" />}
              {(d.status === 'closed-beta' || d.status === 'open-beta') && <Icon name="material-symbols:science" class="material-symbols-rounded icon-xs" aria-hidden="true" />}
              {d.status === 'coming-soon' && <Icon name="material-symbols:hourglass-empty" class="material-symbols-rounded icon-xs" aria-hidden="true" />}
              {d.status === 'paused' && <Icon name="material-symbols:pause-circle" class="material-symbols-rounded icon-xs" aria-hidden="true" />}
              <span>{ui.statusLabels[d.status]}</span>
            </span>
            <span><Icon name="material-symbols:sell" class="material-symbols-rounded icon-xs" aria-hidden="true" /><span>{ui.version} {d.version}</span></span>
            <span><Icon name="material-symbols:android" class="material-symbols-rounded icon-xs" aria-hidden="true" /><span>Android {d.minAndroid}+</span></span>
          </div>
        </div>
      </header>

      <!-- Prominent install buttons -->
      <div class="cta-row mb-2" data-pagefind-ignore>
        <a class="btn-install" href="#install"><i class="bi bi-google-play"></i> {ui.join}</a>
        {d.githubUrl && <a class="btn-ghost" href={d.githubUrl} target="_blank" rel="noopener"><i class="bi bi-github"></i> {ui.githubBtn}</a>}
      </div>
      

      <!-- 2. Introduction -->
      <section class="section-block reveal">
        <div class="prose"><p set:html={desc.replace(/\n/g, '<br />')} /></div>
      </section>
    </div>

    <!-- 2.5 Scroll sequence: features paired with screenshots -->
    {d.features.length > 0 && (
      <ScrollSequence steps={sequenceSteps} label={d.name} />
    )}

    <!-- 3. Screenshots (Apple-style interactive gallery) -->
    <ScreenshotGallery
      screenshots={d.screenshots}
      title={ui.screenshots}
      lang={lang}
      appId={app.id}
    />

    <div class="container page-narrow">
      <!-- 4. Features -->
      {d.features.length > 0 && (
        <section class="section-block">
          <h2 class="block-title reveal">
            <Icon name="material-symbols:auto-awesome" class="material-symbols-rounded text-accent" aria-hidden="true" />
            <span>{ui.features}</span>
          </h2>
          <div class="card-grid">
            {d.features.map((f) => (
              <div class="surface-card reveal"><h3>{pick(f.title, lang)}</h3><p>{pick(f.description, lang)}</p></div>
            ))}
          </div>
        </section>
      )}

      <!-- 5. Specs -->
      <section class="section-block reveal">
        <h2 class="block-title">
          <Icon name="material-symbols:fact-check" class="material-symbols-rounded text-accent" aria-hidden="true" />
          <span>{ui.specs}</span>
        </h2>
        <table class="spec-table">
          <tbody>
            <tr><th><Icon name="material-symbols:inventory-2" class="material-symbols-rounded icon-xs" aria-hidden="true" />{ui.packageLabel}</th><td><code>{d.packageName}</code></td></tr>
            <tr><th><Icon name="material-symbols:sell" class="material-symbols-rounded icon-xs" aria-hidden="true" />{ui.version}</th><td>{d.version}</td></tr>
            <tr><th><Icon name="material-symbols:android" class="material-symbols-rounded icon-xs" aria-hidden="true" />{ui.minAndroid}</th><td>Android {d.minAndroid}</td></tr>
            {d.targetAndroid && <tr><th><Icon name="material-symbols:smartphone" class="material-symbols-rounded icon-xs" aria-hidden="true" />{ui.targetAndroidLabel}</th><td>Android {d.targetAndroid}</td></tr>}
            {d.specs.map((s) => <tr><th>{pick(s.label, lang)}</th><td>{s.value}</td></tr>)}
          </tbody>
        </table>
        {d.tech.length > 0 && <div class="chip-row mt-3">{d.tech.map((x) => <span class="chip chip-muted">{x}</span>)}</div>}
        {(d.permissions ?? []).length > 0 && <div class="chip-row mt-3">{(d.permissions ?? []).map((x) => <span class="chip chip-muted"><code>{x}</code></span>)}</div>}
      </section>

      <!-- 6 & 7. Installation + beta instructions -->
      <section class="section-block reveal" id="install">
        <h2 class="block-title">
          <Icon name="material-symbols:checklist" class="material-symbols-rounded text-accent" aria-hidden="true" />
          <span>{ui.stepsTitle}</span>
        </h2>
        <ol class="steps">
          {steps.map((st) => (
            <li>
              <div>
                <h3>
                  <Icon name={`material-symbols:${String(st.icon).replaceAll('_','-')}`} class="material-symbols-rounded step-icon" aria-hidden="true" />
                  <span>{st.s[0]}</span>
                  {st.optional && <span class="chip chip-muted">{ui.optional}</span>}
                </h3>
                <p>{st.s[1]}</p>
                {st.url
                  ? <a class="btn-ghost" href={st.url} target="_blank" rel="noopener"><span>{st.label}</span> <Icon name="material-symbols:open-in-new" class="material-symbols-rounded icon-sm" aria-hidden="true" /></a>
                  : <span class="btn-ghost is-placeholder" aria-disabled="true">{st.label}</span>}
                {st.extra && st.extra.map((g) => <a class="btn-ghost ms-2" href={g.url} target="_blank" rel="noopener"><span>{g.name}</span> <Icon name="material-symbols:open-in-new" class="material-symbols-rounded icon-sm" aria-hidden="true" /></a>)}
                {!st.url && <div class="placeholder-note">{ui.placeholder}</div>}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- 8. FAQ -->
      {d.faq.length > 0 && (
        <section class="section-block reveal">
          <h2 class="block-title">
            <Icon name="material-symbols:help" class="material-symbols-rounded text-accent" aria-hidden="true" />
            <span>{ui.faq}</span>
          </h2>
          {d.faq.map((x) => (
            <details class="faq">
              <summary>
                <span>{pick(x.q, lang)}</span>
                <Icon name="material-symbols:expand-more" class="material-symbols-rounded faq-arrow" aria-hidden="true" />
              </summary>
              <p>{pick(x.a, lang)}</p>
            </details>
          ))}
        </section>
      )}

      <!-- 9. Changelog -->
      <section class="section-block reveal">
        <h2 class="block-title">
          <Icon name="material-symbols:history" class="material-symbols-rounded text-accent" aria-hidden="true" />
          <span>{ui.changelog}</span>
        </h2>
        {d.changelog.map((c) => (
          <div class="changelog-entry">
            <h3 class="d-flex align-items-center gap-2">
              <Icon name="material-symbols:commit" class="material-symbols-rounded icon-xs text-accent" aria-hidden="true" />
              <span>{c.version}</span>
              <span class="meta d-inline">{c.date}</span>
            </h3>
            <ul>{c.notes.map((n) => <li>{pick(n, lang)}</li>)}</ul>
          </div>
        ))}
      </section>

      <!-- 10. Feedback and links -->
      <section class="section-block reveal">
        <h2 class="block-title">
          <Icon name="material-symbols:link" class="material-symbols-rounded text-accent" aria-hidden="true" />
          <span>{ui.links}</span>
        </h2>
        <p style="color:var(--text-secondary)">{ui.feedbackHow}</p>
        <div class="cta-row">
          {d.githubUrl && (
            <a class="btn-ghost" href={d.githubUrl} target="_blank" rel="noopener">
              <i class="bi bi-github"></i>
              <span>{ui.githubBtn}</span>
              <Icon name="material-symbols:open-in-new" class="material-symbols-rounded icon-xs" aria-hidden="true" />
            </a>
          )}
          {d.playStoreUrl && (
            <a class="btn-ghost" href={d.playStoreUrl} target="_blank" rel="noopener">
              <i class="bi bi-google-play"></i>
              <span>{ui.playBtn}</span>
              <Icon name="material-symbols:open-in-new" class="material-symbols-rounded icon-xs" aria-hidden="true" />
            </a>
          )}
          {d.privacyUrl && (
            <a class="btn-ghost" href={d.privacyUrl}>
              <Icon name="material-symbols:policy" class="material-symbols-rounded icon-sm" aria-hidden="true" />
              <span>{ui.privacy}</span>
            </a>
          )}
        </div>
      </section>
    </div>
  </main>
</Base>



