---
import type { HTMLAttributes } from 'astro/types';
import { fade } from 'astro:transitions';
import { Icon } from 'astro-icon/components';

export interface Props extends Omit<HTMLAttributes<'button'>, 'type' | 'role'> {
  id: string;
  checked?: boolean;
  transitionName?: string | false;
  transitionAnimate?: 'initial' | 'slide' | 'fade' | 'none' | ReturnType<typeof fade>;
  class?: string;
}

const {
  id,
  checked = false,
  transitionName = id,
  transitionAnimate = fade({ duration: '0.28s' }),
  class: className,
  ...rest
} = Astro.props;
---

<button
  type="button"
  id={id}
  class:list={['switch-btn', className]}
  role="switch"
  aria-checked={checked ? 'true' : 'false'}
  transition:name={transitionName || undefined}
  transition:animate={transitionAnimate}
  {...rest}
>
  <span class="switch-thumb" aria-hidden="true">
    <Icon name="lucide:x" class="switch-icon switch-icon-off" />
    <Icon name="lucide:check" class="switch-icon switch-icon-on" />
  </span>
</button>
