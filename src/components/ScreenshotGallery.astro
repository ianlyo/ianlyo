---
import { Icon } from 'astro-icon/components';
import { t, pick, type Lang } from '../i18n/ui';

export interface ScreenshotItem {
  src: string;
  alt: { zh: string; en?: string };
}

interface Props {
  screenshots: ScreenshotItem[];
  lang: Lang;
  appId: string;
  title?: string;
}

const { screenshots = [], lang, appId, title } = Astro.props;
const ui = t(lang).beta;
const sectionTitle = title ?? ui.screenshots;

const serializedScreenshots = screenshots.map((s) => ({
  src: s.src,
  alt: pick(s.alt, lang),
  filename: s.src.split('/').pop() ?? 'screenshot.png',
}));
---

<section class="screenshot-gallery-section" data-porsche-section id={`gallery-section-${appId}`} aria-label={sectionTitle}>
  <div class="gallery-viewport-stage">
    <div class="gallery-header-wrap">
      <h2 class="block-title reveal">
        <Icon name="lucide:images" class="ui-icon text-accent" aria-hidden="true" />
        <span>{sectionTitle}</span>
      </h2>
    </div>

    {screenshots.length === 0 ? (
      <div class="gallery-empty-wrap">
        <div class="shot-empty">
          {ui.screenshotEmpty.replace('{id}', appId)}
        </div>
      </div>
    ) : (
      <div
        class="apple-gallery"
        data-gallery
        data-screenshots={JSON.stringify(serializedScreenshots)}
        data-app-id={appId}
      >
        <div class="gallery-track-outer">
          <div
            class="gallery-track"
            tabindex="0"
            role="region"
            aria-label={sectionTitle}
          >
            {screenshots.map((s, index) => (
              <div
                class="gallery-slide"
                data-slide-index={index}
                style={`--slide-idx: ${Math.min(index, 5)}`}
              >
                <button
                  type="button"
                  class="screenshot-card"
                  data-lightbox-trigger={index}
                  aria-label={`${pick(s.alt, lang)} - ${ui.lightboxZoomHint}`}
                  title={ui.lightboxZoomHint}
                >
                  <img
                    src={s.src}
                    alt={pick(s.alt, lang)}
                    loading={index < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <span class="zoom-badge" aria-hidden="true">
                    <Icon name="lucide:zoom-in" class="ui-icon" />
                  </span>
                </button>
              </div>
            ))}
          </div>
        </div>

        <!-- Apple.com style bottom controls bar -->
        <div class="gallery-controls reveal reveal-fade delay-1">
          <div class="gallery-indicators" role="tablist" aria-label={sectionTitle}>
            {screenshots.map((_, index) => (
              <button
                type="button"
                class={`gallery-dot ${index === 0 ? 'is-active' : ''}`}
                data-dot-index={index}
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-label={ui.screenshotIndex.replace('{current}', String(index + 1)).replace('{total}', String(screenshots.length))}
              />
            ))}
          </div>

          <div class="gallery-nav-buttons">
            <button
              type="button"
              class="apple-nav-btn prev"
              data-action="prev"
              aria-label={ui.prevScreenshot}
              disabled
            >
              <Icon name="lucide:chevron-left" class="ui-icon" aria-hidden="true" />
            </button>
            <button
              type="button"
              class="apple-nav-btn next"
              data-action="next"
              aria-label={ui.nextScreenshot}
            >
              <Icon name="lucide:chevron-right" class="ui-icon" aria-hidden="true" />
            </button>
          </div>
        </div>

        <!-- Full-screen High-Resolution Lightbox Viewer -->
        <div
          class="screenshot-lightbox"
          id={`lightbox-${appId}`}
          aria-hidden="true"
          role="dialog"
          aria-modal="true"
          aria-label={sectionTitle}
        >
          <div class="lightbox-backdrop" data-lightbox-close></div>

          <div class="lightbox-content">
            <!-- Lightbox Header (Back arrow + image title + raw link + close button) -->
            <div class="lightbox-header">
              <button
                type="button"
                class="lightbox-back-btn"
                data-lightbox-close
                aria-label={ui.lightboxClose}
                title={ui.lightboxClose}
              >
                <Icon name="lucide:arrow-left" class="ui-icon" aria-hidden="true" />
                <span class="lightbox-title" id={`lightbox-title-${appId}`}></span>
              </button>

              <div class="lightbox-actions">
                <span class="lightbox-counter" id={`lightbox-counter-${appId}`}></span>
                <button
                  type="button"
                  class="lightbox-action-btn"
                  data-lightbox-close
                  aria-label={ui.lightboxClose}
                  title={ui.lightboxClose}
                >
                  <Icon name="lucide:x" class="ui-icon" aria-hidden="true" />
                </button>
              </div>
            </div>

            <!-- Lightbox Stage: Prev / Next Buttons + Centered High-Res Image -->
            <div class="lightbox-stage">
              <button
                type="button"
                class="lightbox-nav-btn prev"
                data-lightbox-prev
                aria-label={ui.prevScreenshot}
              >
                <Icon name="lucide:chevron-left" class="ui-icon" aria-hidden="true" />
              </button>

              <div class="lightbox-img-wrap" id={`lightbox-wrap-${appId}`}>
                <img
                  src=""
                  alt=""
                  class="lightbox-img"
                  id={`lightbox-img-${appId}`}
                  title={ui.lightboxZoomHint}
                />
              </div>

              <button
                type="button"
                class="lightbox-nav-btn next"
                data-lightbox-next
                aria-label={ui.nextScreenshot}
              >
                <Icon name="lucide:chevron-right" class="ui-icon" aria-hidden="true" />
              </button>
            </div>
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .screenshot-gallery-section {
    position: relative;
    width: 100%;
    max-width: 100%;
    padding: 3.5rem 0 1.5rem;
    overflow: hidden;
    box-sizing: border-box;
    --gallery-gutter: clamp(3rem, 9vw, 10rem);
    --card-height: clamp(500px, 72vh, 700px);
    --card-width: calc(var(--card-height) * 1080 / 2400);
  }

  .gallery-header-wrap,
  .gallery-empty-wrap {
    padding-left: var(--gallery-gutter);
    padding-right: var(--gallery-gutter);
    margin: 0 auto 1.25rem;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
  }

  .apple-gallery {
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .apple-gallery.is-centered .gallery-track-outer {
    display: flex;
    justify-content: center;
  }
  .apple-gallery.is-centered .gallery-track {
    margin: 0 auto;
    justify-content: center;
  }
  .apple-gallery.is-centered .gallery-slide {
    opacity: 1 !important;
    transform: none !important;
  }
  .apple-gallery.is-centered .gallery-controls {
    display: none;
  }

  /* Horizontal track */
  .gallery-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scroll-padding-left: var(--gallery-gutter);
    scroll-padding-right: var(--gallery-gutter);
    scroll-padding-inline: var(--gallery-gutter);
    scrollbar-width: none;
    padding-top: 1rem;
    padding-bottom: 1.5rem;
    padding-left: var(--gallery-gutter);
    padding-right: var(--gallery-gutter);
    outline: none;
    box-sizing: border-box;
    cursor: grab;
  }
  .gallery-track.is-dragging {
    cursor: grabbing;
    user-select: none;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }
  .gallery-track::-webkit-scrollbar {
    display: none;
  }

  .gallery-slide {
    flex: 0 0 auto;
    width: var(--card-width);
    max-width: 85vw;
    scroll-snap-align: start;
    scroll-snap-stop: normal;
    display: flex;
    justify-content: center;
    box-sizing: border-box;
    opacity: 0.72;
    transform: scale(0.94);
    transition: transform 0.45s var(--ease-graceful), opacity 0.45s var(--ease-fade);
  }
  .gallery-slide.is-focused {
    opacity: 1;
    transform: scale(1);
  }

  /* Staggered entrance animation when scrolled into view */
  .apple-gallery:not(.is-revealed) .screenshot-card {
    opacity: 0;
    transform: translate3d(0, 22px, 0) scale(0.95);
  }
  .apple-gallery.is-revealed .screenshot-card {
    animation: galleryCardRise 0.7s var(--ease-graceful) calc(var(--slide-idx, 0) * 70ms) backwards;
  }
  @keyframes galleryCardRise {
    from {
      opacity: 0;
      transform: translate3d(0, 22px, 0) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-slide,
    .apple-gallery .screenshot-card {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      animation: none !important;
    }
  }

  :global(html[data-reduce-motion='true']) .gallery-slide,
  :global(html[data-reduce-motion='true']) .apple-gallery .screenshot-card {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
    animation: none !important;
  }

  /* Interactive Apple-grade screenshot cards */
  .screenshot-card {
    width: 100%;
    height: var(--card-height);
    aspect-ratio: 1080 / 2400;
    max-width: 100%;
    border-radius: 28px;
    overflow: hidden;
    position: relative;
    background: var(--bg-surface-subtle);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 16px 36px -12px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.05);
    transition: transform 0.25s var(--ease-out-expo), box-shadow 0.25s ease, border-color 0.25s ease;
    cursor: zoom-in;
    padding: 0;
    display: block;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
    box-sizing: border-box;
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }

  :global([data-bs-theme='light']) .screenshot-card {
    box-shadow: 0 14px 32px -10px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.05);
  }

  .screenshot-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 44px -12px rgba(0, 0, 0, 0.5);
    border-color: var(--accent-primary);
  }

  .screenshot-card:hover .zoom-badge {
    opacity: 1;
    transform: scale(1);
  }

  .screenshot-card img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
    border-radius: 26px;
  }

  .zoom-badge {
    position: absolute;
    bottom: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }
  .zoom-badge .material-symbols-rounded,
  .zoom-badge .ui-icon {
    font-size: 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Apple-style bottom controls */
  .gallery-controls {
    padding-left: var(--gallery-gutter);
    padding-right: var(--gallery-gutter);
    margin: 1.25rem auto 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
  }

  .gallery-indicators {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .gallery-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full, 9999px);
    background: var(--text-muted);
    opacity: 0.35;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.25s var(--ease-out-expo);
  }

  .gallery-dot:hover {
    opacity: 0.75;
  }

  .gallery-dot.is-active {
    width: 24px;
    height: 8px;
    background: var(--accent-primary);
    opacity: 1;
  }

  .gallery-nav-buttons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Circular glass buttons */
  .apple-nav-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(40, 40, 44, 0.5);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    color: var(--text-primary);
    transition: all 0.2s var(--ease-out-expo);
    padding: 0;
  }

  :global([data-bs-theme='light']) .apple-nav-btn {
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: rgba(0, 0, 0, 0.05);
  }

  .apple-nav-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.3);
    transform: scale(1.06);
  }

  :global([data-bs-theme='light']) .apple-nav-btn:hover:not(:disabled) {
    background: rgba(0, 0, 0, 0.1);
    border-color: rgba(0, 0, 0, 0.2);
  }

  .apple-nav-btn:active:not(:disabled) {
    transform: scale(0.95);
  }

  .apple-nav-btn:disabled {
    opacity: 0.25;
    cursor: not-allowed;
    pointer-events: none;
  }

  .apple-nav-btn .material-symbols-rounded,
  .apple-nav-btn .ui-icon {
    font-size: 1.45rem;
    width: 1.45rem;
    height: 1.45rem;
  }

  /* ==========================================================================
     High-Resolution Fullscreen Lightbox
     ========================================================================== */
  .screenshot-lightbox {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-out-expo);
  }
  .screenshot-lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    z-index: 1;
  }

  .lightbox-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    transform: scale(0.96);
    transition: transform 0.28s var(--ease-out-expo);
  }
  .screenshot-lightbox.is-open .lightbox-content {
    transform: scale(1);
  }

  .lightbox-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    color: #fff;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0) 100%);
  }

  .lightbox-back-btn {
    background: transparent;
    border: none;
    color: #fff;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: var(--radius-sm, 8px);
    transition: opacity 0.2s ease;
  }
  .lightbox-back-btn:hover {
    opacity: 0.8;
  }
  .lightbox-title {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.9);
  }

  .lightbox-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .lightbox-counter {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.08em;
  }

  .lightbox-action-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #fff;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    padding: 0;
  }
  .lightbox-action-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
    transform: scale(1.05);
  }

  .lightbox-stage {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem 1.5rem;
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }

  .lightbox-nav-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(40, 40, 44, 0.55);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
    z-index: 5;
    flex-shrink: 0;
  }
  .lightbox-nav-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.25);
    transform: scale(1.08);
  }
  .lightbox-nav-btn:disabled {
    opacity: 0.2;
    cursor: not-allowed;
  }
  .lightbox-nav-btn .material-symbols-rounded,
  .lightbox-nav-btn .ui-icon {
    font-size: 1.6rem;
    width: 1.6rem;
    height: 1.6rem;
  }

  .lightbox-img-wrap {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
    overflow: hidden;
    cursor: pointer;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: calc(100vh - 120px);
    max-height: calc(100dvh - 120px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.85);
    transition: transform 0.28s var(--ease-out-expo);
    transform-origin: center center;
    cursor: zoom-in;
    user-select: none;
    -webkit-user-drag: none;
  }

  .lightbox-img.is-zoomed {
    transform: scale(2.2);
    cursor: zoom-out;
  }

  .lightbox-img.is-fading {
    animation: lightboxImgSwap 0.24s var(--ease-out-expo) backwards;
  }

  @keyframes lightboxImgSwap {
    from {
      opacity: 0;
      transform: scale(0.975);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (min-width: 769px) {
    .screenshot-gallery-section {
      height: 100vh;
      height: 100dvh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 0;
    }
    .gallery-viewport-stage {
      width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
    }
    .gallery-track-outer {
      width: 100%;
      overflow: hidden;
      position: relative;
    }
    .gallery-track {
      width: max-content;
      overflow-x: visible;
      scroll-snap-type: none;
      scroll-behavior: auto;
      cursor: default;
      gap: clamp(1.75rem, 3vw, 3rem);
    }
    .gallery-slide {
      scroll-snap-align: none;
    }
  }

  @media (max-width: 768px) {
    .screenshot-gallery-section {
      height: 100vh;
      height: 100dvh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 0;
      --gallery-gutter: 1.5rem;
      --card-height: clamp(380px, 60vh, 500px);
      --card-width: calc(var(--card-height) * 1080 / 2400);
    }
    .gallery-viewport-stage {
      width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
    }
    .gallery-track-outer {
      width: 100%;
      overflow: hidden;
      position: relative;
    }
    .gallery-track {
      width: max-content;
      overflow-x: visible;
      scroll-snap-type: none;
      scroll-behavior: auto;
      cursor: default;
      gap: 1.25rem;
      padding-top: 0.5rem;
      padding-bottom: 0.75rem;
      padding-left: var(--gallery-gutter);
      padding-right: var(--gallery-gutter);
    }
    .gallery-slide {
      scroll-snap-align: none;
    }
    .screenshot-card {
      border-radius: 16px;
      box-shadow: 0 10px 25px -8px rgba(0, 0, 0, 0.45);
    }
    .screenshot-card img {
      border-radius: 15px;
    }
    .gallery-controls {
      margin-top: 0.75rem;
    }
    .lightbox-stage {
      padding: 0 0.5rem 1rem;
    }
    .lightbox-nav-btn {
      width: 40px;
      height: 40px;
    }
    .lightbox-img {
      max-width: 94vw;
      max-height: calc(100vh - 110px);
      max-height: calc(100dvh - 110px);
    }
  }
</style>

<script>
  import '../scripts/screenshotGallery';
</script>
