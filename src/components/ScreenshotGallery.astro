---
import { Icon } from 'astro-icon/components';
import { t, pick, type Lang } from '../i18n/ui';

export interface ScreenshotItem {
  src: string;
  alt: { zh: string; en?: string };
}

interface Props {
  screenshots: ScreenshotItem[];
  lang: Lang;
  appId: string;
  title?: string;
}

const { screenshots = [], lang, appId, title } = Astro.props;
const ui = t(lang).beta;
const sectionTitle = title ?? ui.screenshots;
---

<section class="screenshot-gallery-section" aria-label={sectionTitle}>
  <div class="gallery-header-wrap">
    <h2 class="block-title">
      <Icon name="material-symbols:photo-library" class="material-symbols-rounded text-accent" aria-hidden="true" />
      <span>{sectionTitle}</span>
    </h2>
  </div>

  {screenshots.length === 0 ? (
    <div class="gallery-empty-wrap">
      <div class="shot-empty">
        {ui.screenshotEmpty.replace('{id}', appId)}
      </div>
    </div>
  ) : (
    <div class="apple-gallery" data-gallery>
      <div
        class="gallery-track"
        tabindex="0"
        role="region"
        aria-label={sectionTitle}
      >
        {screenshots.map((s, index) => (
          <div
            class="gallery-slide"
            data-slide-index={index}
          >
            <div class="screenshot-card">
              <img
                src={s.src}
                alt={pick(s.alt, lang)}
                loading={index < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
          </div>
        ))}
      </div>

      <!-- Apple.com style bottom controls bar (indicator pills on left + ONLY < > buttons on right) -->
      <div class="gallery-controls">
        <div class="gallery-indicators" role="tablist" aria-label={sectionTitle}>
          {screenshots.map((_, index) => (
            <button
              type="button"
              class={`gallery-dot ${index === 0 ? 'is-active' : ''}`}
              data-dot-index={index}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-label={ui.screenshotIndex.replace('{current}', String(index + 1)).replace('{total}', String(screenshots.length))}
            />
          ))}
        </div>

        <div class="gallery-nav-buttons">
          <button
            type="button"
            class="apple-nav-btn prev"
            data-action="prev"
            aria-label={ui.prevScreenshot}
            disabled
          >
            <Icon name="material-symbols:chevron-left" class="material-symbols-rounded" aria-hidden="true" />
          </button>
          <button
            type="button"
            class="apple-nav-btn next"
            data-action="next"
            aria-label={ui.nextScreenshot}
          >
            <Icon name="material-symbols:chevron-right" class="material-symbols-rounded" aria-hidden="true" />
          </button>
        </div>
      </div>
    </div>
  )}
</section>

<style>
  .screenshot-gallery-section {
    position: relative;
    width: 100%;
    max-width: 100%;
    padding: 3.5rem 0 1rem;
    overflow: hidden;
    box-sizing: border-box;
  }

  .gallery-header-wrap,
  .gallery-empty-wrap {
    max-width: 760px;
    margin: 0 auto 1.5rem;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  .apple-gallery {
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  /* Horizontal track: smooth snap, contained within viewport, edge padding aligned with content */
  .gallery-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 1rem max(1.5rem, calc((100% - 760px) / 2));
    outline: none;
    box-sizing: border-box;
  }
  .gallery-track::-webkit-scrollbar {
    display: none;
  }

  .gallery-slide {
    flex: 0 0 auto;
    scroll-snap-align: start;
    scroll-snap-stop: normal;
  }

  /* Apple-grade screenshot cards */
  .screenshot-card {
    height: clamp(440px, 62vh, 580px);
    aspect-ratio: 1080 / 2400;
    width: auto;
    border-radius: 24px;
    overflow: hidden;
    position: relative;
    background: var(--bg-surface-subtle);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 16px 36px -12px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.05);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }

  :global([data-bs-theme='light']) .screenshot-card {
    box-shadow: 0 14px 32px -10px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.05);
  }

  .screenshot-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 44px -12px rgba(0, 0, 0, 0.5);
    border-color: var(--border-hover);
  }

  .screenshot-card img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    border-radius: 22px;
  }

  /* Apple-style bottom controls (pills on left, single < > on right) */
  .gallery-controls {
    max-width: 760px;
    margin: 1.25rem auto 0;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
  }

  .gallery-indicators {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .gallery-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--text-muted);
    opacity: 0.35;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-dot:hover {
    opacity: 0.75;
  }

  .gallery-dot.is-active {
    width: 24px;
    height: 8px;
    background: var(--accent-primary);
    opacity: 1;
  }

  .gallery-nav-buttons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Circular glass buttons (Apple-style < and >) */
  .apple-nav-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: var(--text-primary);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 0;
  }

  :global([data-bs-theme='light']) .apple-nav-btn {
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: rgba(0, 0, 0, 0.05);
  }

  .apple-nav-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.3);
    transform: scale(1.06);
  }

  :global([data-bs-theme='light']) .apple-nav-btn:hover:not(:disabled) {
    background: rgba(0, 0, 0, 0.1);
    border-color: rgba(0, 0, 0, 0.2);
  }

  .apple-nav-btn:active:not(:disabled) {
    transform: scale(0.95);
  }

  .apple-nav-btn:disabled {
    opacity: 0.25;
    cursor: not-allowed;
    pointer-events: none;
  }

  .apple-nav-btn .material-symbols-rounded {
    font-size: 1.45rem;
  }

  @media (max-width: 768px) {
    .screenshot-card {
      height: clamp(380px, 58vh, 480px);
      border-radius: 16px;
      box-shadow: 0 10px 25px -8px rgba(0, 0, 0, 0.45);
    }
    .screenshot-card img {
      border-radius: 14px;
    }
    .gallery-track {
      gap: 1rem;
      padding: 0.75rem 1.25rem;
    }
    .gallery-slide {
      scroll-snap-align: center;
    }
    .gallery-controls {
      padding: 0 1.25rem;
    }
  }
</style>

<script>
  function setupGalleries() {
    const galleries = document.querySelectorAll<HTMLElement>('[data-gallery]');

    galleries.forEach((gallery) => {
      const track = gallery.querySelector<HTMLElement>('.gallery-track');
      if (!track) return;

      const slides = Array.from(gallery.querySelectorAll<HTMLElement>('.gallery-slide'));
      const prevButton = gallery.querySelector<HTMLButtonElement>('.apple-nav-btn[data-action="prev"]');
      const nextButton = gallery.querySelector<HTMLButtonElement>('.apple-nav-btn[data-action="next"]');
      const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.gallery-dot'));

      if (slides.length === 0) return;

      const getStepDistance = () => {
        const slide = slides[0];
        if (!slide) return 300;
        const style = window.getComputedStyle(track);
        const gap = parseFloat(style.columnGap || style.gap || '24') || 24;
        return slide.offsetWidth + gap;
      };

      const updateControls = () => {
        const scrollLeft = track.scrollLeft;
        const maxScroll = track.scrollWidth - track.clientWidth;
        const atStart = scrollLeft <= 6;
        const atEnd = scrollLeft >= maxScroll - 6;

        if (prevButton) prevButton.disabled = atStart;
        if (nextButton) nextButton.disabled = atEnd;

        // Calculate active index
        const step = getStepDistance();
        const activeIndex = Math.min(
          slides.length - 1,
          Math.max(0, Math.round(scrollLeft / step))
        );

        dots.forEach((dot, index) => {
          const isActive = index === activeIndex;
          dot.classList.toggle('is-active', isActive);
          dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
      };

      const scrollBySlide = (direction: 'prev' | 'next') => {
        const step = getStepDistance();
        track.scrollBy({
          left: direction === 'next' ? step : -step,
          behavior: 'smooth',
        });
      };

      if (prevButton) {
        prevButton.addEventListener('click', () => scrollBySlide('prev'));
      }
      if (nextButton) {
        nextButton.addEventListener('click', () => scrollBySlide('next'));
      }

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const targetIndex = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
          const step = getStepDistance();
          track.scrollTo({
            left: targetIndex * step,
            behavior: 'smooth',
          });
        });
      });

      let ticking = false;
      track.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            updateControls();
            ticking = false;
          });
          ticking = true;
        }
      });

      // Keyboard navigation support
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          scrollBySlide('prev');
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          scrollBySlide('next');
        }
      });

      // Initial control states
      updateControls();
      window.addEventListener('resize', updateControls);
    });
  }

  // Setup on page load and on Astro view transitions
  setupGalleries();
  document.addEventListener('astro:page-load', setupGalleries);
</script>
