---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { t, localePath, type Lang } from '../i18n/ui';
import { COLOR_THEMES, DEFAULT_COLOR_THEME } from '../config/themes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const s = ui.settings;
const zhUrl = '/settings/';
const enUrl = '/en/settings/';
---

<Base lang={lang} title={s.title} description={s.lead} altPath={lang === 'en' ? zhUrl : enUrl}>
  <main class="settings-page container py-5">
    <button
      type="button"
      id="settings-back-btn"
      class="settings-back-btn"
      data-fallback-url={localePath(lang, '/')}
    >
      <Icon name="lucide:arrow-left" class="settings-back-icon" aria-hidden="true" />
      <span>{ui.notFound.back}</span>
    </button>

    <header class="settings-header">
      <h1>{s.title}</h1>
      <p class="settings-lead">{s.lead}</p>
    </header>

    <div class="settings-sections">
      <!-- Appearance & Language -->
      <section class="settings-card" aria-labelledby="settings-appearance-heading">
        <div class="settings-card-header">
          <Icon name="lucide:palette" class="settings-section-icon" aria-hidden="true" />
          <h2 id="settings-appearance-heading">{s.appearanceTitle}</h2>
        </div>

        <div class="settings-row">
          <div class="settings-info">
            <span class="settings-label">{s.themeLabel}</span>
            <span class="settings-desc">{s.themeDesc}</span>
          </div>
          <div class="settings-segmented" role="group" aria-label={s.themeLabel} data-setting-group="theme">
            <button type="button" class="seg-btn seg-btn-icon" data-value="auto">
              <Icon name="lucide:monitor" class="ui-icon icon-xs" aria-hidden="true" />
              <span>{s.themeAuto}</span>
            </button>
            <button type="button" class="seg-btn seg-btn-icon" data-value="light">
              <Icon name="lucide:sun" class="ui-icon icon-xs" aria-hidden="true" />
              <span>{s.themeLight}</span>
            </button>
            <button type="button" class="seg-btn seg-btn-icon" data-value="dark">
              <Icon name="lucide:moon" class="ui-icon icon-xs" aria-hidden="true" />
              <span>{s.themeDark}</span>
            </button>
          </div>
        </div>

        <div class="settings-row settings-row-stacked color-picker-row">
          <div class="settings-info">
            <span class="settings-label color-picker-heading" id="color-theme-label">
              <span>{s.colorThemeLabel}</span>
              <span class="color-picker-sep" aria-hidden="true">-</span>
              <span class="color-picker-current" id="color-theme-current-name">
                {s.colorThemes[DEFAULT_COLOR_THEME].name}
              </span>
            </span>
          </div>
          <div class="color-swatch-list" role="radiogroup" aria-labelledby="color-theme-label" data-color-theme-group>
            {COLOR_THEMES.map((theme) => {
              const info = s.colorThemes[theme.id];
              return (
                <button
                  type="button"
                  class="color-swatch-btn"
                  role="radio"
                  aria-checked="false"
                  aria-label={info.name}
                  title={info.name}
                  data-color-theme-btn={theme.id}
                  data-color-name={info.name}
                  style={`--swatch-light:${theme.light.accent};--swatch-dark:${theme.dark.accent};`}
                />
              );
            })}
          </div>
        </div>

        <div class="settings-row">
          <div class="settings-info">
            <span class="settings-label">{s.langLabel}</span>
            <span class="settings-desc">{s.langDesc}</span>
          </div>
          <div class="settings-segmented" role="group" aria-label={s.langLabel} data-setting-group="lang" data-zh-url={zhUrl} data-en-url={enUrl}>
            <button type="button" class:list={['seg-btn', { 'is-active': lang === 'zh-Hant' }]} data-value="zh-Hant">繁體中文</button>
            <button type="button" class:list={['seg-btn', { 'is-active': lang === 'en' }]} data-value="en">English</button>
          </div>
        </div>
      </section>

      <!-- Accessibility & Reading -->
      <section class="settings-card" aria-labelledby="settings-a11y-heading">
        <div class="settings-card-header">
          <Icon name="lucide:person-standing" class="settings-section-icon" aria-hidden="true" />
          <h2 id="settings-a11y-heading">{s.a11yTitle}</h2>
        </div>

        <div class="settings-row">
          <div class="settings-info">
            <span class="settings-label">{s.motionLabel}</span>
            <span class="settings-desc">{s.motionDesc}</span>
          </div>
          <div class="settings-segmented" role="group" aria-label={s.motionLabel} data-setting-group="motion">
            <button type="button" class="seg-btn" data-value="off">{s.motionOff}</button>
            <button type="button" class="seg-btn" data-value="on">{s.motionOn}</button>
            <button type="button" class="seg-btn" data-value="system">{s.motionSystem}</button>
          </div>
        </div>

        <div class="settings-row">
          <div class="settings-info">
            <span class="settings-label">{s.fontScaleLabel}</span>
            <span class="settings-desc">{s.fontScaleDesc}</span>
          </div>
          <div class="settings-segmented" role="group" aria-label={s.fontScaleLabel} data-setting-group="fontScale">
            <button type="button" class="seg-btn" data-value="normal">{s.fontNormal}</button>
            <button type="button" class="seg-btn" data-value="large">{s.fontLarge}</button>
            <button type="button" class="seg-btn" data-value="xlarge">{s.fontXlarge}</button>
          </div>
        </div>

        <div class="settings-row">
          <div class="settings-info">
            <label class="settings-label" for="toggle-high-contrast">{s.contrastLabel}</label>
            <span class="settings-desc">{s.contrastDesc}</span>
          </div>
          <button
            type="button"
            id="toggle-high-contrast"
            class="switch-btn"
            role="switch"
            aria-checked="false"
            data-setting-switch="highContrast"
          >
            <span class="switch-thumb"></span>
          </button>
        </div>

        <div class="settings-row">
          <div class="settings-info">
            <label class="settings-label" for="toggle-progress-bar">{s.progressBarLabel}</label>
            <span class="settings-desc">{s.progressBarDesc}</span>
          </div>
          <button
            type="button"
            id="toggle-progress-bar"
            class="switch-btn"
            role="switch"
            aria-checked="true"
            data-setting-switch="progressBar"
          >
            <span class="switch-thumb"></span>
          </button>
        </div>
      </section>

      <div class="settings-actions">
        <button type="button" id="settings-reset-btn" class="reset-btn">
          <Icon name="lucide:rotate-ccw" class="ui-icon icon-xs" aria-hidden="true" />
          <span>{s.resetBtn}</span>
        </button>
      </div>
    </div>

    <div class="settings-toast" id="settings-toast" role="status" aria-live="polite" data-saved={s.savedToast} data-reset={s.resetToast}></div>
  </main>
</Base>

<style>
  .settings-page {
    max-width: 50rem;
    margin: 0 auto;
    padding-top: 6rem !important;
    padding-bottom: 4rem !important;
  }
  .settings-header {
    margin-bottom: 2rem;
  }
  .settings-header h1 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
  }
  .settings-lead {
    color: var(--text-secondary, rgba(128, 128, 128, 0.9));
    font-size: 1rem;
    margin: 0;
  }
  .settings-sections {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .settings-card {
    background: var(--bg-surface, var(--bs-body-bg));
    border: 1px solid var(--border, rgba(128, 128, 128, 0.2));
    border-radius: var(--radius-lg, 20px);
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }
  .settings-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border-subtle, rgba(128, 128, 128, 0.22));
    background: var(--bg-surface-subtle, rgba(128, 128, 128, 0.08));
    color: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.18s ease, border-color 0.18s ease, transform 0.15s ease;
  }
  .settings-back-btn:hover {
    background: rgba(128, 128, 128, 0.16);
    border-color: var(--border, rgba(128, 128, 128, 0.38));
    transform: translateX(-2px);
  }
  .settings-back-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  .settings-card-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle, rgba(128, 128, 128, 0.14));
  }
  .settings-section-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--accent-primary);
  }
  .settings-card-header h2 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
  }
  .settings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border-subtle, rgba(128, 128, 128, 0.12));
  }
  .settings-row-stacked {
    flex-direction: column;
    align-items: stretch;
    gap: 0.9rem;
  }
  .settings-row:last-child {
    border-bottom: none;
    padding-bottom: 0.25rem;
  }
  .settings-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
    min-width: 0;
  }
  .settings-label {
    font-weight: 600;
    font-size: 0.98rem;
  }
  .settings-desc {
    font-size: 0.85rem;
    color: var(--text-secondary, rgba(128, 128, 128, 0.88));
    line-height: 1.45;
  }
  .settings-segmented {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 12px;
    background: var(--bg-surface-subtle, rgba(128, 128, 128, 0.1));
    border: 1px solid var(--border-subtle, rgba(128, 128, 128, 0.15));
    flex-shrink: 0;
  }
  .seg-btn {
    border: none;
    background: transparent;
    color: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.42rem 0.78rem;
    border-radius: 9px;
    cursor: pointer;
    transition: background-color 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
    white-space: nowrap;
  }
  .seg-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.38rem;
  }
  .seg-btn:hover {
    background: rgba(128, 128, 128, 0.12);
  }
  .seg-btn.is-active {
    background: var(--accent-primary);
    color: var(--accent-text, #ffffff);
    font-weight: 600;
    box-shadow: 0 2px 10px var(--accent-glow);
  }

  /* Minimalist Circular Color Swatches */
  .color-picker-row {
    gap: 0.9rem;
  }
  .color-picker-heading {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .color-picker-sep,
  .color-picker-current {
    color: var(--text-secondary);
    font-weight: 500;
  }
  .color-swatch-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding: 0.35rem 0.25rem;
  }
  .color-swatch-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(15, 23, 42, 0.14);
    padding: 0;
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
    background: var(--swatch-light);
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.22);
    transition: transform 0.18s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.18s ease;
  }
  :global([data-bs-theme="dark"]) .color-swatch-btn {
    background: var(--swatch-dark);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.38);
  }
  .color-swatch-btn:hover {
    transform: scale(1.08);
  }
  .color-swatch-btn:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 4px;
  }
  .color-swatch-btn.is-active {
    box-shadow:
      inset 0 2px 4px rgba(0, 0, 0, 0.2),
      0 0 0 3px var(--bg-surface),
      0 0 0 5.5px var(--accent-primary);
  }
  :global([data-bs-theme="dark"]) .color-swatch-btn.is-active {
    box-shadow:
      inset 0 2px 5px rgba(0, 0, 0, 0.35),
      0 0 0 3px var(--bg-surface),
      0 0 0 5.5px var(--accent-primary);
  }

  .switch-btn {
    position: relative;
    width: 48px;
    height: 28px;
    border-radius: 999px;
    border: 1px solid var(--border-strong, rgba(128, 128, 128, 0.3));
    background: rgba(128, 128, 128, 0.25);
    padding: 2px;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .switch-btn[aria-checked='true'] {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
  }
  .switch-thumb {
    display: block;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .switch-btn[aria-checked='true'] .switch-thumb {
    transform: translateX(20px);
  }
  .settings-actions {
    display: flex;
    justify-content: flex-end;
  }
  .reset-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--border-strong, rgba(128, 128, 128, 0.3));
    background: transparent;
    color: inherit;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.18s ease, border-color 0.18s ease;
  }
  .reset-btn:hover {
    background: var(--accent-subtle);
    border-color: var(--border-hover);
  }
  .settings-toast {
    position: fixed;
    left: 50%;
    bottom: 2rem;
    transform: translate(-50%, 16px);
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    background: rgba(24, 24, 28, 0.92);
    color: #fff;
    font-size: 0.88rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 3000;
  }
  .settings-toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  @media (max-width: 680px) {
    .settings-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .settings-segmented {
      width: 100%;
    }
    .seg-btn {
      flex: 1;
      text-align: center;
    }
  }
</style>

<script>
  import {
    getPreferencesState,
    setThemeMode,
    setColorTheme,
    setReduceMotion,
    setFontScale,
    setHighContrast,
    setProgressBar,
    resetAllPreferences,
    type PreferencesState,
    type ReduceMotionPref,
    type FontScalePref,
  } from '../scripts/themeManager';
  import type { ColorThemeId, ThemeMode } from '../config/themes';

  function initSettingsPage() {
    const page = document.querySelector<HTMLElement>('.settings-page');
    if (!page || page.dataset.bound === '1') return;
    page.dataset.bound = '1';

    const toast = document.getElementById('settings-toast');
    let toastTimer: number | undefined;
    const showToast = (msg?: string) => {
      if (!toast || !msg) return;
      toast.textContent = msg;
      toast.classList.add('is-visible');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 1800);
    };

    const setGroupActive = (groupName: string, value: string) => {
      const group = page.querySelector<HTMLElement>(`[data-setting-group="${groupName}"]`);
      if (!group) return;
      group.querySelectorAll<HTMLButtonElement>('.seg-btn').forEach((btn) => {
        btn.classList.toggle('is-active', btn.dataset.value === value);
      });
    };

    const syncUI = (state: PreferencesState) => {
      setGroupActive('theme', state.themeMode);
      setGroupActive('motion', state.reduceMotion);
      setGroupActive('fontScale', state.fontScale);

      const colorNameEl = document.getElementById('color-theme-current-name');
      page.querySelectorAll<HTMLButtonElement>('[data-color-theme-btn]').forEach((btn) => {
        const isActive = btn.dataset.colorThemeBtn === state.colorTheme;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-checked', isActive ? 'true' : 'false');
        if (isActive && colorNameEl && btn.dataset.colorName) {
          colorNameEl.textContent = btn.dataset.colorName;
        }
      });

      const hcBtn = page.querySelector<HTMLButtonElement>('[data-setting-switch="highContrast"]');
      hcBtn?.setAttribute('aria-checked', state.highContrast ? 'true' : 'false');

      const pbBtn = page.querySelector<HTMLButtonElement>('[data-setting-switch="progressBar"]');
      pbBtn?.setAttribute('aria-checked', state.progressBar ? 'true' : 'false');
    };

    syncUI(getPreferencesState());

    window.addEventListener('site:preferences-change', (e) => {
      const detail = (e as CustomEvent<PreferencesState>).detail;
      if (detail) syncUI(detail);
    });

    // Bind segmented groups
    page.querySelectorAll<HTMLElement>('[data-setting-group]').forEach((group) => {
      const groupName = group.dataset.settingGroup;
      group.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.seg-btn');
        if (!btn || !btn.dataset.value) return;
        const val = btn.dataset.value;
        if (groupName === 'theme') {
          setThemeMode(val as ThemeMode);
          showToast(toast?.dataset.saved);
        } else if (groupName === 'motion') {
          setReduceMotion(val as ReduceMotionPref);
          showToast(toast?.dataset.saved);
        } else if (groupName === 'fontScale') {
          setFontScale(val as FontScalePref);
          showToast(toast?.dataset.saved);
        } else if (groupName === 'lang') {
          try {
            localStorage.setItem('preferred-locale', val);
          } catch {}
          const target = val === 'en' ? group.dataset.enUrl : group.dataset.zhUrl;
          if (target && window.location.pathname !== target) {
            window.location.href = target;
          }
        }
      });
    });

    // Bind Color Theme swatch grid
    const colorGroup = page.querySelector<HTMLElement>('[data-color-theme-group]');
    colorGroup?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-color-theme-btn]');
      const themeId = btn?.dataset.colorThemeBtn as ColorThemeId | undefined;
      if (!themeId) return;
      setColorTheme(themeId);
      showToast(toast?.dataset.saved);
    });

    // Bind switches
    page.querySelectorAll<HTMLButtonElement>('[data-setting-switch]').forEach((btn) => {
      const name = btn.dataset.settingSwitch as 'highContrast' | 'progressBar';
      btn.addEventListener('click', () => {
        const next = btn.getAttribute('aria-checked') !== 'true';
        if (name === 'highContrast') setHighContrast(next);
        else setProgressBar(next);
        showToast(toast?.dataset.saved);
      });
    });

    // Back button
    const backBtn = document.getElementById('settings-back-btn');
    backBtn?.addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = backBtn.dataset.fallbackUrl || '/';
      }
    });

    // Reset button
    const resetBtn = document.getElementById('settings-reset-btn');
    resetBtn?.addEventListener('click', () => {
      resetAllPreferences();
      showToast(toast?.dataset.reset);
    });
  }

  initSettingsPage();
  document.addEventListener('astro:page-load', initSettingsPage);
</script>
