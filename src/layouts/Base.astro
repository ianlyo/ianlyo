---
import '@fontsource-variable/chiron-goround-tc';
import '../styles/bootstrap-used.css';
import '../styles/style.css';
import '../styles/site.css';
import '../styles/themes.css';
import { Icon } from 'astro-icon/components';
import { t, localePath, switchLangPath, type Lang } from '../i18n/ui';
import { SITE } from '../config/site';
import { COLOR_THEMES, DEFAULT_COLOR_THEME } from '../config/themes';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: Date;
  /** Path of the equivalent page in the other language (if it exists). Defaults to the language-swapped path. */
  altPath?: string | null;
}

const {
  lang = 'zh-Hant',
  title,
  description,
  image = SITE.ogImage,
  imageAlt = SITE.ogImageAlt,
  type = 'website',
  noindex = false,
  jsonLd,
  publishedTime,
  altPath,
} = Astro.props;

const ui = t(lang);
const site = Astro.site!;
const pageTitle = title ? `${title} | ${SITE.name}` : ui.siteTitle;
const pageDesc = description ?? ui.siteDescription;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const otherLang: Lang = lang === 'en' ? 'zh-Hant' : 'en';
const otherPath = altPath === undefined ? switchLangPath(Astro.url.pathname, otherLang) : altPath;
const zhPath = lang === 'en' ? otherPath : Astro.url.pathname;
const enPath = lang === 'en' ? Astro.url.pathname : otherPath;
const path = Astro.url.pathname;
const isActive = (p: string) => path.startsWith(localePath(lang, p)) && p !== '/';
const themeMetaMap = Object.fromEntries(
  COLOR_THEMES.map((item) => [item.id, { light: item.light.themeColor, dark: item.dark.themeColor }])
);
---
<!doctype html>
<html lang={lang} data-bs-theme="light" data-color-theme={DEFAULT_COLOR_THEME}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}

  <link rel="icon" type="image/png" href={SITE.github.avatarUrl} />
  <link rel="apple-touch-icon" href={SITE.github.avatarUrl} />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content={SITE.themeColor} />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/rss.xml" />
  {zhPath && <link rel="alternate" hreflang="zh-Hant" href={new URL(zhPath, site).href} />}
  {enPath && <link rel="alternate" hreflang="en" href={new URL(enPath, site).href} />}

  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={imageAlt} />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_TW'} />
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={imageAlt} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <!-- Anti-FOUC Theme & Auto Locale Detection Script -->
  <script is:inline define:vars={{ currentLang: lang, enTarget: enPath, zhTarget: zhPath, themeMetaMap, defaultColorTheme: DEFAULT_COLOR_THEME }}>
    (function () {
      try {
        // 1. Theme & Color Palette initialization
        var savedTheme = localStorage.getItem('theme');
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = !savedTheme || savedTheme === 'auto' ? (prefersDark ? 'dark' : 'light') : (savedTheme === 'dark' ? 'dark' : 'light');
        var savedColor = localStorage.getItem('pref-color-theme');
        var colorTheme = savedColor && themeMetaMap[savedColor] ? savedColor : defaultColorTheme;

        document.documentElement.setAttribute('data-bs-theme', theme);
        document.documentElement.setAttribute('data-color-theme', colorTheme);

        var metaTheme = document.querySelector('meta[name="theme-color"]');
        if (metaTheme && themeMetaMap[colorTheme]) {
          metaTheme.setAttribute('content', themeMetaMap[colorTheme][theme]);
        }

        // 1b. Accessibility & reading preferences initialization
        var motionPref = localStorage.getItem('pref-reduce-motion') || 'off';
        var sysReduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var isReduced = motionPref === 'on' || (motionPref === 'system' && sysReduce);
        document.documentElement.setAttribute('data-reduce-motion', isReduced ? 'true' : 'false');

        var fontScale = localStorage.getItem('pref-font-scale') || 'normal';
        document.documentElement.setAttribute('data-font-scale', fontScale);

        var highContrast = localStorage.getItem('pref-high-contrast') === 'true';
        document.documentElement.setAttribute('data-high-contrast', highContrast ? 'true' : 'false');

        var progressBarPref = localStorage.getItem('pref-progress-bar');
        document.documentElement.setAttribute('data-progress-bar', progressBarPref === 'false' ? 'false' : 'true');

        // 2. Language auto-detection & preference routing
        var savedLang = localStorage.getItem('preferred-locale');
        if (!savedLang) {
          var langs = navigator.languages || [navigator.language || ''];
          var prefersEn = false;
          for (var i = 0; i < langs.length; i++) {
            var l = (langs[i] || '').toLowerCase();
            if (l.startsWith('zh')) {
              prefersEn = false;
              break;
            }
            if (l.startsWith('en')) {
              prefersEn = true;
              break;
            }
          }
          if (prefersEn && currentLang !== 'en' && enTarget) {
            window.location.replace(enTarget + window.location.search + window.location.hash);
          }
        } else if (savedLang === 'en' && currentLang !== 'en' && enTarget) {
          window.location.replace(enTarget + window.location.search + window.location.hash);
        } else if (savedLang === 'zh-Hant' && currentLang === 'en' && zhTarget) {
          window.location.replace(zhTarget + window.location.search + window.location.hash);
        }
      } catch (e) {}
    })();
  </script>

</head>
<body>
  <!-- Reading scroll progress indicator -->
  <div class="scroll-progress-bar" id="scroll-progress" aria-hidden="true"></div>
  <a class="skip-link" href="#main">Skip to content</a>
  <nav class="site-nav" aria-label="Main navigation">
    <div class="nav-left">
      <!-- Mobile hamburger toggle button (three lines like Google Photos) -->
      <button
        type="button"
        class="nav-hamburger-btn d-inline-flex d-md-none"
        id="nav-drawer-open"
        aria-label={ui.nav.menuOpen}
        aria-controls="nav-drawer"
        aria-expanded="false"
      >
        <Icon name="lucide:menu" class="nav-icon" aria-hidden="true" />
      </button>

      <a class="brand-mark" href={localePath(lang, '/')} aria-label={`${SITE.name} home`}>LNU<span>.</span></a>
    </div>

    <!-- Desktop nav links (hidden on mobile, visible on desktop) -->
    <div class="nav-links d-none d-md-flex">
      <a href={localePath(lang, '/apps-dev/')} class:list={[{ active: isActive('/apps-dev') }]}>
        <Icon name="lucide:layout-grid" class="nav-icon" aria-hidden="true" />
        <span>{ui.nav.beta}</span>
      </a>
      <a href="/blog/" class:list={[{ active: path.startsWith('/blog') }]}>
        <Icon name="lucide:newspaper" class="nav-icon" aria-hidden="true" />
        <span>{ui.nav.blog}</span>
      </a>
      <a href={localePath(lang, '/') + '#projects'}>
        <Icon name="lucide:code-2" class="nav-icon" aria-hidden="true" />
        <span>{ui.nav.projects}</span>
      </a>
      <a href={localePath(lang, '/search/')} class="nav-action-icon" aria-label={ui.nav.search} title={ui.nav.search}>
        <Icon name="lucide:search" class="nav-icon" aria-hidden="true" />
      </a>
      <a href={SITE.github.reposUrl} target="_blank" rel="noopener" class="nav-action-icon" aria-label="GitHub" title="GitHub">
        <Icon name="simple-icons:github" class="nav-icon" aria-hidden="true" />
      </a>
    </div>

    <!-- Right controls (Search on mobile + Theme toggle on all) -->
    <div class="nav-right">
      <a href={localePath(lang, '/search/')} class="nav-icon-btn d-inline-flex d-md-none" aria-label={ui.nav.search} title={ui.nav.search}>
        <Icon name="lucide:search" class="nav-icon" aria-hidden="true" />
      </a>
      <button class="nav-icon-btn" id="share-btn" type="button" aria-label={ui.nav.share} title={ui.nav.share} data-share-title={pageTitle} data-share-text={pageDesc} data-share-url={canonical} data-copied={ui.nav.shareCopied}>
        <Icon name="lucide:share-2" class="nav-icon" aria-hidden="true" />
      </button>
      <a href={localePath(lang, '/settings/')} class:list={['nav-icon-btn', { active: isActive('/settings') }]} aria-label={ui.nav.settings} title={ui.nav.settings}>
        <Icon name="lucide:settings" class="nav-icon" aria-hidden="true" />
      </a>
      <button
        class="theme-toggle"
        id="theme-toggle"
        type="button"
        aria-label={ui.nav.themeToggleAuto}
        title={ui.nav.themeToggleAuto}
        data-label-auto={ui.nav.themeToggleAuto}
        data-label-light={ui.nav.themeToggleLight}
        data-label-dark={ui.nav.themeToggleDark}
      >
        <Icon name="lucide:sun-medium" class="nav-icon" aria-hidden="true" />
      </button>
    </div>
  </nav>

  <!-- Google Photos-style slide-out navigation drawer (Mobile) -->
  <div class="nav-drawer-backdrop" id="nav-drawer-backdrop" aria-hidden="true"></div>
  <aside class="nav-drawer" id="nav-drawer" aria-label="Mobile navigation" aria-hidden="true" inert>
    <div class="nav-drawer-header">
      <div class="nav-drawer-brand">
        <span class="brand-mark">LNU<span>.</span></span>
        <span class="nav-drawer-subtitle">{SITE.author} · Developer</span>
      </div>
      <button type="button" class="nav-drawer-close" id="nav-drawer-close" aria-label={ui.nav.menuClose}>
        <Icon name="lucide:x" class="nav-icon" aria-hidden="true" />
      </button>
    </div>

    <div class="nav-drawer-body">
      <ul class="nav-drawer-list">
        <li>
          <a href={localePath(lang, '/')} class:list={['nav-drawer-item', { active: path === '/' || path === '/en/' }]}>
            <Icon name="lucide:home" class="nav-icon" aria-hidden="true" />
            <span>{ui.nav.home}</span>
          </a>
        </li>
        <li>
          <a href={localePath(lang, '/apps-dev/')} class:list={['nav-drawer-item', { active: isActive('/apps-dev') }]}>
            <Icon name="lucide:layout-grid" class="nav-icon" aria-hidden="true" />
            <span>{ui.nav.beta}</span>
          </a>
        </li>
        <li>
          <a href="/blog/" class:list={['nav-drawer-item', { active: path.startsWith('/blog') }]}>
            <Icon name="lucide:newspaper" class="nav-icon" aria-hidden="true" />
            <span>{ui.nav.blog}</span>
          </a>
        </li>
        <li>
          <a href={localePath(lang, '/') + '#projects'} class="nav-drawer-item">
            <Icon name="lucide:code-2" class="nav-icon" aria-hidden="true" />
            <span>{ui.nav.projects}</span>
          </a>
        </li>
        <li>
          <a href={localePath(lang, '/search/')} class:list={['nav-drawer-item', { active: path.includes('/search') }]}>
            <Icon name="lucide:search" class="nav-icon" aria-hidden="true" />
            <span>{ui.nav.search}</span>
          </a>
        </li>
      </ul>

      <hr class="nav-drawer-divider" />

      <div class="nav-drawer-secondary">
        <a href={localePath(lang, '/settings/')} class:list={['nav-drawer-item', { active: isActive('/settings') }]}>
          <Icon name="lucide:settings" class="nav-icon" aria-hidden="true" />
          <span>{ui.nav.settings}</span>
        </a>
        {otherPath && (
          <a href={otherPath} hreflang={otherLang} class="nav-drawer-item lang-switch" data-lang-switch={otherLang}>
            <Icon name="lucide:languages" class="nav-icon" aria-hidden="true" />
            <span>{ui.langSwitch}</span>
          </a>
        )}
        <a href={SITE.github.reposUrl} target="_blank" rel="noopener" class="nav-drawer-item">
          <Icon name="simple-icons:github" class="nav-icon" aria-hidden="true" />
          <span>GitHub</span>
          <Icon name="lucide:external-link" class="nav-icon ms-auto" aria-hidden="true" />
        </a>
      </div>
    </div>
  </aside>

  <div id="main"><slot /></div>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-content">
        <p class="footer-copy">
          <a href={SITE.github.reposUrl} target="_blank" rel="noopener" class="footer-repo-btn" aria-label="GitHub"><Icon name="simple-icons:github" class="ui-icon" aria-hidden="true" /></a>
          © <span id="current-year">{new Date().getFullYear()}</span> {SITE.name}
        </p>
        <div class="footer-links">
          {otherPath && (
            <label class="footer-lang-select-wrap d-inline-flex align-items-center gap-1">
              <Icon name="lucide:languages" class="ui-icon icon-xs" aria-hidden="true" />
              <select
                class="footer-lang-select"
                aria-label={ui.langSwitch}
                data-lang-select
              >
                <option value={lang} data-href={path} selected>
                  {lang === 'zh-Hant' ? '繁體中文' : 'English'}
                </option>
                <option value={otherLang} data-href={otherPath}>
                  {otherLang === 'zh-Hant' ? '繁體中文' : 'English'}
                </option>
              </select>
            </label>
          )}
          <a href={localePath(lang, '/settings/')} class="d-inline-flex align-items-center gap-1"><Icon name="lucide:settings" class="ui-icon icon-xs" aria-hidden="true" /><span>{ui.nav.settings}</span></a>
          <a href="/rss.xml" class="d-inline-flex align-items-center gap-1"><Icon name="lucide:rss" class="ui-icon icon-xs" aria-hidden="true" /><span>{ui.footer.rss}</span></a>
          <a href="#main" class="d-inline-flex align-items-center gap-1"><span>{ui.footer.top}</span><Icon name="lucide:arrow-up" class="ui-icon icon-xs" aria-hidden="true" /></a>
        </div>
      </div>
    </div>
  </footer>

  <div class="share-toast" id="share-toast" role="status" aria-live="polite"></div>
  <script src="../scripts/siteCore.ts"></script>
</body>
</html>
