---
import { Icon } from 'astro-icon/components';
import { t, localePath, switchLangPath, type Lang } from '../i18n/ui';
import { SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: Date;
  /** Path of the equivalent page in the other language (if it exists). Defaults to the language-swapped path. */
  altPath?: string | null;
}

const {
  lang = 'zh-Hant',
  title,
  description,
  image = SITE.ogImage,
  imageAlt = SITE.ogImageAlt,
  type = 'website',
  noindex = false,
  jsonLd,
  publishedTime,
  altPath,
} = Astro.props;

const ui = t(lang);
const site = Astro.site!;
const pageTitle = title ? `${title} | ${SITE.name}` : ui.siteTitle;
const pageDesc = description ?? ui.siteDescription;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const otherLang: Lang = lang === 'en' ? 'zh-Hant' : 'en';
const otherPath = altPath === undefined ? switchLangPath(Astro.url.pathname, otherLang) : altPath;
const zhPath = lang === 'en' ? otherPath : Astro.url.pathname;
const enPath = lang === 'en' ? Astro.url.pathname : otherPath;
const path = Astro.url.pathname;
const isActive = (p: string) => path.startsWith(localePath(lang, p)) && p !== '/';
---
<!doctype html>
<html lang={lang} data-bs-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}

  <link rel="icon" type="image/png" href={SITE.github.avatarUrl} />
  <link rel="apple-touch-icon" href={SITE.github.avatarUrl} />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content={SITE.themeColor} />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/rss.xml" />
  {zhPath && <link rel="alternate" hreflang="zh-Hant" href={new URL(zhPath, site).href} />}
  {enPath && <link rel="alternate" hreflang="en" href={new URL(enPath, site).href} />}

  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={imageAlt} />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_TW'} />
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={imageAlt} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <!-- Anti-FOUC theme script (same logic as the original site) -->
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = !saved || saved === 'auto' ? (prefersDark ? 'dark' : 'light') : saved;
        document.documentElement.setAttribute('data-bs-theme', theme);
      } catch (e) {}
    })();
  </script>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />
  <link rel="stylesheet" href="/assets/css/style.css?v=2.1" />
  <link rel="stylesheet" href="/assets/css/site.css?v=2.1" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <nav class="site-nav" aria-label="Main navigation">
    <div class="nav-left">
      <!-- Mobile hamburger toggle button (three lines like Google Photos) -->
      <button
        type="button"
        class="nav-hamburger-btn d-inline-flex d-md-none"
        id="nav-drawer-open"
        aria-label={ui.nav.menuOpen}
        aria-controls="nav-drawer"
        aria-expanded="false"
      >
        <Icon name="material-symbols:menu" class="material-symbols-rounded" aria-hidden="true" />
      </button>

      <a class="brand-mark" href={localePath(lang, '/')} aria-label={`${SITE.name} home`}>IAN<span>.</span></a>
    </div>

    <!-- Desktop nav links (hidden on mobile, visible on desktop) -->
    <div class="nav-links d-none d-md-flex">
      <a href={localePath(lang, '/beta/')} class:list={[{ active: isActive('/beta') }]}>{ui.nav.beta}</a>
      <a href="/blog/" class:list={[{ active: path.startsWith('/blog') }]}>{ui.nav.blog}</a>
      <a href={localePath(lang, '/') + '#projects'}>{ui.nav.projects}</a>
      <a href="/search/" aria-label={ui.nav.search} title={ui.nav.search}><Icon name="material-symbols:search" class="material-symbols-rounded" aria-hidden="true" /></a>
      <a href={SITE.github.reposUrl} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
        <i class="bi bi-github" aria-hidden="true"></i>
      </a>
      {otherPath && (
        <a href={otherPath} hreflang={otherLang} class="lang-switch">
          <Icon name="material-symbols:translate" class="material-symbols-rounded icon-xs" aria-hidden="true" />
          <span>{ui.langSwitch}</span>
        </a>
      )}
    </div>

    <!-- Right controls (Search on mobile + Theme toggle on all) -->
    <div class="nav-right">
      <a href="/search/" class="nav-icon-btn d-inline-flex d-md-none" aria-label={ui.nav.search} title={ui.nav.search}>
        <Icon name="material-symbols:search" class="material-symbols-rounded" aria-hidden="true" />
      </a>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle theme" title="Toggle theme">
        <Icon name="material-symbols:contrast" class="material-symbols-rounded" aria-hidden="true" />
      </button>
    </div>
  </nav>

  <!-- Google Photos-style slide-out navigation drawer (Mobile) -->
  <div class="nav-drawer-backdrop" id="nav-drawer-backdrop" aria-hidden="true"></div>
  <aside class="nav-drawer" id="nav-drawer" aria-label="Mobile navigation" aria-hidden="true">
    <div class="nav-drawer-header">
      <div class="nav-drawer-brand">
        <span class="brand-mark">IAN<span>.</span></span>
        <span class="nav-drawer-subtitle">{SITE.author} · Android Developer</span>
      </div>
      <button type="button" class="nav-drawer-close" id="nav-drawer-close" aria-label={ui.nav.menuClose}>
        <Icon name="material-symbols:close" class="material-symbols-rounded" aria-hidden="true" />
      </button>
    </div>

    <div class="nav-drawer-body">
      <ul class="nav-drawer-list">
        <li>
          <a href={localePath(lang, '/')} class:list={['nav-drawer-item', { active: path === '/' || path === '/en/' }]}>
            <Icon name="material-symbols:home-outline" class="material-symbols-rounded" aria-hidden="true" />
            <span>{ui.nav.home}</span>
          </a>
        </li>
        <li>
          <a href={localePath(lang, '/beta/')} class:list={['nav-drawer-item', { active: isActive('/beta') }]}>
            <Icon name="material-symbols:science-outline" class="material-symbols-rounded" aria-hidden="true" />
            <span>{ui.nav.beta}</span>
          </a>
        </li>
        <li>
          <a href="/blog/" class:list={['nav-drawer-item', { active: path.startsWith('/blog') }]}>
            <Icon name="material-symbols:article-outline" class="material-symbols-rounded" aria-hidden="true" />
            <span>{ui.nav.blog}</span>
          </a>
        </li>
        <li>
          <a href={localePath(lang, '/') + '#projects'} class="nav-drawer-item">
            <Icon name="material-symbols:code" class="material-symbols-rounded" aria-hidden="true" />
            <span>{ui.nav.projects}</span>
          </a>
        </li>
        <li>
          <a href="/search/" class:list={['nav-drawer-item', { active: path.startsWith('/search') }]}>
            <Icon name="material-symbols:search" class="material-symbols-rounded" aria-hidden="true" />
            <span>{ui.nav.search}</span>
          </a>
        </li>
      </ul>

      <hr class="nav-drawer-divider" />

      <div class="nav-drawer-secondary">
        {otherPath && (
          <a href={otherPath} hreflang={otherLang} class="nav-drawer-item">
            <Icon name="material-symbols:translate" class="material-symbols-rounded" aria-hidden="true" />
            <span>{ui.langSwitch}</span>
          </a>
        )}
        <a href={SITE.github.reposUrl} target="_blank" rel="noopener" class="nav-drawer-item">
          <i class="bi bi-github" aria-hidden="true"></i>
          <span>GitHub</span>
          <Icon name="material-symbols:open-in-new" class="material-symbols-rounded icon-xs ms-auto" aria-hidden="true" />
        </a>
      </div>
    </div>
  </aside>

  <div id="main"><slot /></div>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-content">
        <p class="footer-copy">
          <a href={SITE.github.reposUrl} target="_blank" rel="noopener" class="footer-repo-btn" aria-label="GitHub"><i class="bi bi-github" aria-hidden="true"></i></a>
          © <span id="current-year"></span> {SITE.name} · {ui.footer.built}
        </p>
        <div class="footer-links">
          <a href="/rss.xml" class="d-inline-flex align-items-center gap-1"><Icon name="material-symbols:rss-feed" class="material-symbols-rounded icon-xs" aria-hidden="true" /><span>{ui.footer.rss}</span></a>
          <a href="#main" class="d-inline-flex align-items-center gap-1"><span>{ui.footer.top}</span><Icon name="material-symbols:arrow-upward" class="material-symbols-rounded icon-xs" aria-hidden="true" /></a>
        </div>
      </div>
    </div>
  </footer>

  <script is:inline src="/assets/js/script.js?v=2.0"></script>
  <script is:inline>
    (function () {
      function setupNavDrawer() {
        var openBtn = document.getElementById('nav-drawer-open');
        var closeBtn = document.getElementById('nav-drawer-close');
        var backdrop = document.getElementById('nav-drawer-backdrop');
        var drawer = document.getElementById('nav-drawer');
        if (!drawer || !openBtn || !backdrop) return;

        function openDrawer() {
          drawer.classList.add('is-open');
          backdrop.classList.add('is-open');
          drawer.setAttribute('aria-hidden', 'false');
          openBtn.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }

        function closeDrawer() {
          drawer.classList.remove('is-open');
          backdrop.classList.remove('is-open');
          drawer.setAttribute('aria-hidden', 'true');
          openBtn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }

        openBtn.addEventListener('click', openDrawer);
        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        backdrop.addEventListener('click', closeDrawer);

        var drawerLinks = drawer.querySelectorAll('a');
        drawerLinks.forEach(function (link) {
          link.addEventListener('click', closeDrawer);
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
            closeDrawer();
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupNavDrawer);
      } else {
        setupNavDrawer();
      }
      document.addEventListener('astro:page-load', setupNavDrawer);
    })();
  </script>
</body>
</html>
