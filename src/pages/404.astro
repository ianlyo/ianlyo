---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { t } from '../i18n/ui';
import { SITE } from '../config/site';

// Cloudflare Pages serves this as 404.html for every unknown URL, so one page
// must cover both languages. Copy comes from the i18n SSOT; the client picks
// the language from the URL prefix (/en/...).
const zh = t('zh-Hant').notFound;
const en = t('en').notFound;
---
<Base title={zh.title} noindex altPath={null}>
  <main class="page nf" id="nf" data-i18n={JSON.stringify({ 'zh-Hant': zh, en })} data-site-name={SITE.name}>
    <canvas id="nf-starfield" class="nf-starfield-canvas" aria-hidden="true"></canvas>
    <div class="nf-nebula" aria-hidden="true"></div>
    <div class="container nf-inner">
      <div class="hero-enter-scale">
        <h1 class="nf-code glitch" id="nf-code" data-text="404" aria-label="404" title="Drag me!">404</h1>
      </div>
      <h2 class="nf-title hero-enter enter-delay-1" id="nf-title">{zh.title}</h2>
      <p class="nf-quote hero-enter enter-delay-2" id="nf-quote" aria-live="polite"></p>
      <p class="nf-lead hero-enter enter-delay-2" id="nf-lead">{zh.lead}</p>
      <div class="nf-actions hero-enter enter-delay-3">
        <a class="btn btn-primary" id="nf-home" href="/">{zh.home}</a>
        <button class="btn btn-outline" id="nf-back" type="button">{zh.back}</button>
      </div>
      <p class="nf-score" id="nf-score" hidden></p>
    </div>

    <!-- 浮動在右上角的 GitHub 頭像 (可拖曳與互動) -->
    <div class="nf-avatar-wrap hero-enter-fade enter-delay-2" id="nf-avatar" title="Drag me!">
      <img src={SITE.github.avatarUrl} alt={SITE.name} class="nf-avatar-img" width="88" height="88" loading="eager" />
      <span class="nf-avatar-halo" aria-hidden="true"></span>
    </div>

    <!-- 浮動在右下角的可變造型角色 (機器人 / 太空人 / Android 隨機切換，點擊切換) -->
    <div class="nf-astro" id="nf-astro" title="Drag me! (Click to switch character)">
      <!-- 造型 0：科技機器人 (Robot) -->
      <svg class="char-svg char-robot" id="char-robot" viewBox="0 0 120 140" width="110" height="128">
        <line x1="60" y1="130" x2="60" y2="140" stroke="currentColor" stroke-opacity=".3" stroke-width="2" stroke-dasharray="3 4"/>
        <rect x="30" y="62" width="60" height="58" rx="22" fill="#e8eaf6"/>
        <rect x="38" y="70" width="44" height="16" rx="6" fill="#c5cae9"/>
        <circle cx="60" cy="38" r="30" fill="#f5f5fa"/>
        <rect x="38" y="24" width="44" height="28" rx="14" fill="#1a1d3a"/>
        <circle cx="52" cy="38" r="3" fill="#7c8cff"/>
        <circle cx="68" cy="38" r="3" fill="#7c8cff"/>
        <rect x="14" y="70" width="18" height="12" rx="6" fill="#e8eaf6"/>
        <rect x="88" y="70" width="18" height="12" rx="6" fill="#e8eaf6"/>
      </svg>
      <!-- 造型 1：經典太空人 (Astronaut with backpack & golden visor) -->
      <svg class="char-svg char-astronaut" id="char-astronaut" viewBox="0 0 120 140" width="110" height="128" style="display: none;">
        <!-- 背部氧氣背包 (Backpack) -->
        <rect x="22" y="44" width="76" height="66" rx="14" fill="#cbd5e1" stroke="#94a3b8" stroke-width="2"/>
        <rect x="32" y="48" width="56" height="12" rx="4" fill="#e2e8f0"/>
        <!-- 宇航服軀幹 (Suit Body) -->
        <rect x="32" y="52" width="56" height="58" rx="18" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2"/>
        <!-- 胸口生命控制面板 (Chest control module) -->
        <rect x="42" y="62" width="36" height="22" rx="6" fill="#1e293b"/>
        <circle cx="50" cy="73" r="3" fill="#38bdf8"/>
        <circle cx="60" cy="73" r="3" fill="#4ade80"/>
        <circle cx="70" cy="73" r="3" fill="#f43f5e"/>
        <!-- 太空圓頭盔 (Astronaut Helmet) -->
        <circle cx="60" cy="34" r="28" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2"/>
        <!-- 經典金色炫光面罩 (Curved Visor) -->
        <ellipse cx="60" cy="34" rx="20" ry="16" fill="url(#visor-gold)"/>
        <!-- 面罩高光弧光 (Visor Glare Reflection) -->
        <path d="M 46 25 Q 60 20 74 25" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.8"/>
        <!-- 宇航服手臂 (Arms) -->
        <rect x="15" y="58" width="16" height="34" rx="8" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2"/>
        <rect x="89" y="58" width="16" height="34" rx="8" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2"/>
        <!-- 漸層定義 -->
        <defs>
          <linearGradient id="visor-gold" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#fbbf24"/>
            <stop offset="60%" stop-color="#f59e0b"/>
            <stop offset="100%" stop-color="#d97706"/>
          </linearGradient>
        </defs>
      </svg>
      <!-- 造型 2：Google Material Symbol Android 機器人 -->
      <div class="char-svg char-android" id="char-android" style="display: none;">
        <Icon name="material-symbols:android" class="android-icon-svg" />
      </div>
    </div>

    <canvas id="nf-confetti" aria-hidden="true"></canvas>
  </main>

  <script>
    import '../scripts/notFoundPlayground';
  </script>

  <style is:global>
    .nf { position: relative; min-height: 70vh; display: grid; place-items: center; overflow: hidden; --px: 0; --py: 0; }
    .nf-inner {
      position: relative;
      z-index: 1;
      text-align: center;
      padding-block: clamp(2rem, 6vh, 4.5rem);
      padding-inline: 1rem;
      max-width: 680px;
      margin-inline: auto;
    }
    /* 星空 Canvas 與深邃星雲背景 (Dynamic Starfield Canvas & Nebula Atmosphere) */
    .nf-starfield-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
    }
    .nf-nebula {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background: var(--hero-ambient-glow);
      opacity: 0.95;
    }
    .nf-astro {
      position: absolute;
      right: clamp(1.5rem, 5vw, 4rem);
      bottom: clamp(1.5rem, 5vw, 3.5rem);
      z-index: 2;
      display: inline-block;
      cursor: grab;
      color: var(--text-muted, #888);
    }
    .nf-avatar-wrap {
      position: absolute;
      right: clamp(1.5rem, 5vw, 4rem);
      top: clamp(1.5rem, 5vw, 3.5rem);
      z-index: 2;
      display: inline-block;
      cursor: grab;
      border-radius: 50%;
    }
    .nf-avatar-img {
      display: block;
      border-radius: 50%;
      border: 3px solid var(--border-strong, #cbd5e1);
      box-shadow: 0 8px 24px -4px var(--accent-glow);
      pointer-events: none;
      animation: nf-avatar-float 6s ease-in-out infinite;
    }
    .nf-avatar-halo {
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      background: var(--hero-title-gradient);
      z-index: -1;
      opacity: 0.6;
      filter: blur(6px);
      animation: nf-grad-shift 8s ease infinite alternate;
    }
    @keyframes nf-avatar-float {
      0%, 100% { transform: translateY(0) rotate(3deg); }
      50% { transform: translateY(-14px) rotate(-3deg); }
    }
    .nf-astro, .nf-code, .nf-avatar-wrap {
      cursor: grab;
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
      will-change: translate;
    }
    .nf-astro.is-dragging, .nf-code.is-dragging, .nf-avatar-wrap.is-dragging {
      cursor: grabbing;
      z-index: 20;
    }
    .nf-astro svg, .nf-astro .char-svg {
      animation: nf-float 5s ease-in-out infinite;
      filter: drop-shadow(0 10px 20px rgba(124,140,255,.35));
    }
    .android-icon-svg {
      width: 104px;
      height: 104px;
      color: #3ddc84; /* Android Brand Green */
      filter: drop-shadow(0 10px 24px rgba(61, 220, 132, 0.45));
    }
    @keyframes nf-float { 0%,100% { transform: translateY(0) rotate(-4deg); } 50% { transform: translateY(-16px) rotate(4deg); } }

    .nf-code {
      font-size: clamp(5.5rem, 24vw, 11.5rem);
      font-weight: 900;
      line-height: 0.95;
      margin: 0.5rem 0 0;
      letter-spacing: -0.04em;
      background-image: var(--hero-title-gradient);
      background-size: 260% 260%;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: nf-grad-shift 10s ease infinite alternate;
      filter: drop-shadow(0 12px 32px var(--accent-glow));
    }
    @keyframes nf-grad-shift {
      0% { background-position: 0% 50%; }
      100% { background-position: 100% 50%; }
    }
    .glitch { position: relative; display: inline-block; }
    .glitch::before, .glitch::after {
      content: attr(data-text);
      position: absolute;
      inset: 0;
      overflow: hidden;
      background-image: var(--hero-title-gradient);
      background-size: 260% 260%;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      opacity: 0.85;
      pointer-events: none;
    }
    .glitch::before {
      transform: translate(-3px, 0);
      clip-path: inset(0 0 55% 0);
      filter: drop-shadow(0 -2px 6px var(--glow-chroma-top, rgba(0, 160, 245, 0.75)));
      animation: nf-glitch 3.2s steps(1) infinite;
    }
    .glitch::after {
      transform: translate(3px, 0);
      clip-path: inset(55% 0 0 0);
      filter: drop-shadow(0 2px 6px var(--glow-chroma-bottom, rgba(249, 115, 22, 0.75)));
      animation: nf-glitch 3.2s steps(1) infinite reverse;
    }
    @keyframes nf-glitch {
      0%,92%,100% { transform: translate(0,0); opacity: 0; }
      93% { transform: translate(-4px, 1px); opacity: 0.9; }
      95% { transform: translate(4px, -1px); opacity: 0.95; }
      97% { transform: translate(-2px, 0.5px); opacity: 0.8; }
      99% { transform: translate(2px, -0.5px); opacity: 0.9; }
    }

    .nf-title { font-size: 1.5rem; margin: .5rem 0; }
    .nf-quote { font-size: 1.15rem; font-weight: 600; color: var(--accent, #7c8cff); min-height: 1.6em; margin: .25rem 0; }
    .nf-lead { color: var(--text-muted, #888); margin: 0 0 1.5rem; }
    .nf-actions { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; }
    .nf-score {
      display: inline-block;
      margin-top: 1.25rem;
      padding: 0.35rem 1rem;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--accent-primary, #7c8cff);
      background: var(--bg-surface-subtle, rgba(124, 140, 255, 0.08));
      border: 1px solid var(--border-subtle, rgba(124, 140, 255, 0.25));
      border-radius: 999px;
      box-shadow: 0 4px 14px -2px var(--accent-glow);
      font-variant-numeric: tabular-nums;
      transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .nf-score.score-pop {
      animation: nf-score-bounce 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes nf-score-bounce {
      0% { transform: scale(0.9); }
      50% { transform: scale(1.18); }
      100% { transform: scale(1); }
    }
    #nf-confetti { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 50; }

    @media (prefers-reduced-motion: reduce) {
      .nf-astro svg, .glitch::before, .glitch::after { animation: none; }
      .nf-astro, .nf-stars { transition: none; transform: none; }
    }

    /* 手機與窄螢幕佈局優化 (Mobile & Narrow Viewports < 768px) */
    @media (max-width: 768px) {
      .nf { min-height: 80vh; }
      .nf-code { font-size: clamp(4.2rem, 26vw, 7.5rem); }
      .nf-title { font-size: 1.35rem; }
      .nf-quote { font-size: 1rem; padding-inline: 0.5rem; }
      .nf-lead { font-size: 0.95rem; margin-bottom: 1.25rem; }
      .nf-actions { gap: 0.5rem; }
      .nf-actions .btn { padding: 0.55rem 1.15rem; font-size: 0.95rem; }
      .nf-avatar-wrap {
        right: 1.25rem;
        top: 1rem;
      }
      .nf-avatar-img {
        width: 68px;
        height: 68px;
      }
      .nf-astro {
        right: 1.25rem;
        bottom: 1.25rem;
      }
      .nf-astro svg {
        width: 82px;
        height: 96px;
      }
    }

    /* 桌面超寬與大螢幕增強 (Desktop & Large screens >= 1200px) */
    @media (min-width: 1200px) {
      .nf { min-height: 78vh; }
      .nf-avatar-img { width: 96px; height: 96px; }
      .nf-astro svg { width: 124px; height: 144px; }
      .nf-quote { font-size: 1.25rem; }
    }
  </style>
</Base>
