---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { t } from '../i18n/ui';
import { SITE } from '../config/site';

// Cloudflare Pages serves this as 404.html for every unknown URL, so one page
// must cover both languages. Copy comes from the i18n SSOT; the client picks
// the language from the URL prefix (/en/...).
const zh = t('zh-Hant').notFound;
const en = t('en').notFound;
---
<Base title={zh.title} noindex altPath={null}>
  <main class="page nf" id="nf">
    <canvas id="nf-starfield" class="nf-starfield-canvas" aria-hidden="true"></canvas>
    <div class="nf-nebula" aria-hidden="true"></div>
    <div class="container nf-inner">
      <h1 class="nf-code glitch" id="nf-code" data-text="404" aria-label="404" title="Drag me!">404</h1>
      <h2 class="nf-title" id="nf-title">{zh.title}</h2>
      <p class="nf-quote" id="nf-quote" aria-live="polite"></p>
      <p class="nf-lead" id="nf-lead">{zh.lead}</p>
      <div class="nf-actions">
        <a class="btn btn-primary" id="nf-home" href="/">{zh.home}</a>
        <button class="btn btn-outline" id="nf-back" type="button">{zh.back}</button>
      </div>
      <p class="nf-score" id="nf-score" hidden></p>
    </div>

    <!-- 浮動在右上角的 GitHub 頭像 (可拖曳與互動) -->
    <div class="nf-avatar-wrap" id="nf-avatar" title="Drag me!">
      <img src={SITE.github.avatarUrl} alt={SITE.name} class="nf-avatar-img" width="88" height="88" loading="eager" />
      <span class="nf-avatar-halo" aria-hidden="true"></span>
    </div>

    <!-- 浮動在右下角的可變造型角色 (機器人 / 太空人 / Android 隨機切換，點擊切換) -->
    <div class="nf-astro" id="nf-astro" title="Drag me! (Click to switch character)">
      <!-- 造型 0：科技機器人 (Robot) -->
      <svg class="char-svg char-robot" id="char-robot" viewBox="0 0 120 140" width="110" height="128">
        <line x1="60" y1="130" x2="60" y2="140" stroke="currentColor" stroke-opacity=".3" stroke-width="2" stroke-dasharray="3 4"/>
        <rect x="30" y="62" width="60" height="58" rx="22" fill="#e8eaf6"/>
        <rect x="38" y="70" width="44" height="16" rx="6" fill="#c5cae9"/>
        <circle cx="60" cy="38" r="30" fill="#f5f5fa"/>
        <rect x="38" y="24" width="44" height="28" rx="14" fill="#1a1d3a"/>
        <circle cx="52" cy="38" r="3" fill="#7c8cff"/>
        <circle cx="68" cy="38" r="3" fill="#7c8cff"/>
        <rect x="14" y="70" width="18" height="12" rx="6" fill="#e8eaf6"/>
        <rect x="88" y="70" width="18" height="12" rx="6" fill="#e8eaf6"/>
      </svg>
      <!-- 造型 1：經典太空人 (Astronaut with backpack & golden visor) -->
      <svg class="char-svg char-astronaut" id="char-astronaut" viewBox="0 0 120 140" width="110" height="128" style="display: none;">
        <!-- 背部氧氣背包 (Backpack) -->
        <rect x="22" y="44" width="76" height="66" rx="14" fill="#cbd5e1" stroke="#94a3b8" stroke-width="2"/>
        <rect x="32" y="48" width="56" height="12" rx="4" fill="#e2e8f0"/>
        <!-- 宇航服軀幹 (Suit Body) -->
        <rect x="32" y="52" width="56" height="58" rx="18" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2"/>
        <!-- 胸口生命控制面板 (Chest control module) -->
        <rect x="42" y="62" width="36" height="22" rx="6" fill="#1e293b"/>
        <circle cx="50" cy="73" r="3" fill="#38bdf8"/>
        <circle cx="60" cy="73" r="3" fill="#4ade80"/>
        <circle cx="70" cy="73" r="3" fill="#f43f5e"/>
        <!-- 太空圓頭盔 (Astronaut Helmet) -->
        <circle cx="60" cy="34" r="28" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2"/>
        <!-- 經典金色炫光面罩 (Curved Visor) -->
        <ellipse cx="60" cy="34" rx="20" ry="16" fill="url(#visor-gold)"/>
        <!-- 面罩高光弧光 (Visor Glare Reflection) -->
        <path d="M 46 25 Q 60 20 74 25" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.8"/>
        <!-- 宇航服手臂 (Arms) -->
        <rect x="15" y="58" width="16" height="34" rx="8" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2"/>
        <rect x="89" y="58" width="16" height="34" rx="8" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2"/>
        <!-- 漸層定義 -->
        <defs>
          <linearGradient id="visor-gold" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#fbbf24"/>
            <stop offset="60%" stop-color="#f59e0b"/>
            <stop offset="100%" stop-color="#d97706"/>
          </linearGradient>
        </defs>
      </svg>
      <!-- 造型 2：Google Material Symbol Android 機器人 -->
      <div class="char-svg char-android" id="char-android" style="display: none;">
        <Icon name="material-symbols:android" class="android-icon-svg" />
      </div>
    </div>

    <canvas id="nf-confetti" aria-hidden="true"></canvas>
  </main>

  <script is:inline define:vars={{ dict: { 'zh-Hant': zh, en } }}>
    (function () {
      var isEn = location.pathname.indexOf('/en/') === 0 || location.pathname === '/en';
      var d = dict[isEn ? 'en' : 'zh-Hant'];
      var $ = function (id) { return document.getElementById(id); };
      document.documentElement.lang = isEn ? 'en' : 'zh-Hant';
      document.title = d.title + ' | ianlyo';
      $('nf-title').textContent = d.title;
      $('nf-lead').textContent = d.lead;
      $('nf-home').textContent = d.home;
      $('nf-home').href = isEn ? '/en/' : '/';
      $('nf-back').textContent = d.back;
      $('nf-quote').textContent = d.quotes[Math.floor(Math.random() * d.quotes.length)];

      $('nf-back').addEventListener('click', function () {
        if (history.length > 1) history.back(); else location.href = $('nf-home').href;
      });

      // Parallax: astronaut + stars follow the pointer.
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var root = $('nf');
      if (!reduce) {
        root.addEventListener('pointermove', function (e) {
          var x = (e.clientX / innerWidth - 0.5) * 2;
          var y = (e.clientY / innerHeight - 0.5) * 2;
          root.style.setProperty('--px', x.toFixed(3));
          root.style.setProperty('--py', y.toFixed(3));
        });
      }

      // Elegant Deep Starfield with Interactive Constellation & Mouse Gravitational Repulsion
      var scv = $('nf-starfield'), sctx = scv ? scv.getContext('2d') : null;
      var stars = [];
      var mouse = { x: -1000, y: -1000, radius: 130 };
      var isDark = false;
      var accentRgb = '79, 70, 229';

      function parseCssColorToRgb(colorStr) {
        var c = (colorStr || '').trim();
        if (c.charAt(0) === '#' && (c.length === 7 || c.length === 4)) {
          if (c.length === 4) {
            return parseInt(c[1] + c[1], 16) + ', ' + parseInt(c[2] + c[2], 16) + ', ' + parseInt(c[3] + c[3], 16);
          }
          return parseInt(c.slice(1, 3), 16) + ', ' + parseInt(c.slice(3, 5), 16) + ', ' + parseInt(c.slice(5, 7), 16);
        }
        var m = c.match(/\d+/g);
        if (m && m.length >= 3) return m[0] + ', ' + m[1] + ', ' + m[2];
        return isDark ? '129, 140, 248' : '79, 70, 229';
      }

      function syncStarfieldTheme() {
        isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark' ||
                 (!document.documentElement.getAttribute('data-bs-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);
        var accent = getComputedStyle(document.documentElement).getPropertyValue('--accent-primary');
        accentRgb = parseCssColorToRgb(accent);
      }

      function initStarfield() {
        if (!scv || !sctx) return;
        syncStarfieldTheme();
        scv.width = window.innerWidth;
        scv.height = window.innerHeight;
        stars = [];
        var count = Math.floor((scv.width * scv.height) / 9000); // 數量適度純淨 (約 60~120 顆)

        // 統一度雅一致的色系（跟隨當前主題強調色，不花俏）
        var baseColors = isDark
          ? ['rgba(255, 255, 255, ', 'rgba(' + accentRgb + ', ', 'rgba(226, 232, 240, ']
          : ['rgba(51, 65, 85, ', 'rgba(' + accentRgb + ', ', 'rgba(100, 116, 139, '];

        for (var i = 0; i < count; i++) {
          var origX = Math.random() * scv.width;
          var origY = Math.random() * scv.height;
          stars.push({
            x: origX,
            y: origY,
            origX: origX,
            origY: origY,
            vx: 0,
            vy: 0,
            size: Math.random() * 1.5 + 0.8, // 精緻大小 0.8px ~ 2.3px
            colorBase: baseColors[Math.floor(Math.random() * baseColors.length)],
            baseAlpha: Math.random() * 0.45 + 0.25, // 亮度柔和 (0.25 ~ 0.70)，不刺眼
            twinkleSpeed: Math.random() * 0.02 + 0.01,
            twinkleOffset: Math.random() * Math.PI * 2
          });
        }
      }

      window.addEventListener('pointermove', function (e) {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
      });
      window.addEventListener('pointerleave', function () {
        mouse.x = -1000;
        mouse.y = -1000;
      });

      function drawStarfield() {
        if (!scv || !sctx) return;
        sctx.clearRect(0, 0, scv.width, scv.height);
        var now = Date.now();

        // 1. 星星更新與滑鼠重力/斥力互動
        for (var i = 0; i < stars.length; i++) {
          var s = stars[i];

          // 滑鼠靠近時產生靈動的微斥力與引力透鏡漣漪
          var dx = mouse.x - s.x;
          var dy = mouse.y - s.y;
          var dist = Math.hypot(dx, dy);

          if (dist < mouse.radius && dist > 0) {
            var force = (mouse.radius - dist) / mouse.radius;
            var angle = Math.atan2(dy, dx);
            // 輕推開星星
            s.vx -= Math.cos(angle) * force * 1.6;
            s.vy -= Math.sin(angle) * force * 1.6;
          }

          // 回復彈簧彈力 (Spring back to original position)
          s.vx += (s.origX - s.x) * 0.035;
          s.vy += (s.origY - s.y) * 0.035;
          s.vx *= 0.88; // 摩擦力阻尼
          s.vy *= 0.88;

          s.x += s.vx;
          s.y += s.vy;

          // 柔和微呼吸
          var curAlpha = s.baseAlpha + Math.sin(now * s.twinkleSpeed + s.twinkleOffset) * 0.12;
          curAlpha = Math.max(0.15, Math.min(0.85, curAlpha));

          // 滑鼠接近時的亮感增強
          if (dist < mouse.radius) {
            curAlpha = Math.min(1, curAlpha + (1 - dist / mouse.radius) * 0.35);
          }

          sctx.beginPath();
          sctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
          sctx.fillStyle = s.colorBase + curAlpha.toFixed(2) + ')';
          sctx.fill();
        }

        // 2. 滑鼠附近的星座連線（Constellation Lines）
        var connectDist = 85;
        for (var i = 0; i < stars.length; i++) {
          var s1 = stars[i];
          var dMouse = Math.hypot(mouse.x - s1.x, mouse.y - s1.y);
          if (dMouse < mouse.radius * 1.25) {
            for (var j = i + 1; j < stars.length; j++) {
              var s2 = stars[j];
              var dStars = Math.hypot(s1.x - s2.x, s1.y - s2.y);
              if (dStars < connectDist) {
                var lineAlpha = (1 - dStars / connectDist) * (1 - dMouse / (mouse.radius * 1.25)) * 0.35;
                if (lineAlpha > 0.02) {
                  sctx.beginPath();
                  sctx.moveTo(s1.x, s1.y);
                  sctx.lineTo(s2.x, s2.y);
                  sctx.strokeStyle = isDark
                    ? 'rgba(' + accentRgb + ', ' + lineAlpha.toFixed(3) + ')'
                    : 'rgba(' + accentRgb + ', ' + (lineAlpha * 0.7).toFixed(3) + ')';
                  sctx.lineWidth = 0.85;
                  sctx.stroke();
                }
              }
            }
          }
        }

        requestAnimationFrame(drawStarfield);
      }

      initStarfield();
      if (!reduce) drawStarfield();
      window.addEventListener('resize', initStarfield);
      window.addEventListener('site:preferences-change', initStarfield);

      // Easter egg: confetti + catch counter.
      var cv = $('nf-confetti'), ctx = cv.getContext('2d'), parts = [], raf = 0, count = 0;
      function size() { cv.width = innerWidth; cv.height = innerHeight; }
      size(); addEventListener('resize', size);
      var colors = ['#7c8cff', '#ff7ca8', '#ffd166', '#06d6a0', '#4cc9f0'];
      function burst() {
        for (var i = 0; i < 140; i++) {
          parts.push({
            x: innerWidth / 2, y: innerHeight * 0.6,
            vx: (Math.random() - 0.5) * 16, vy: -Math.random() * 16 - 4,
            s: Math.random() * 7 + 4, r: Math.random() * 6, vr: (Math.random() - 0.5) * 0.4,
            c: colors[i % colors.length], life: 140 + Math.random() * 60
          });
        }
        if (!raf) raf = requestAnimationFrame(tick);
      }
      function tick() {
        ctx.clearRect(0, 0, cv.width, cv.height);
        parts = parts.filter(function (p) { return p.life-- > 0 && p.y < cv.height + 20; });
        parts.forEach(function (p) {
          p.vy += 0.35; p.x += p.vx; p.y += p.vy; p.vx *= 0.99; p.r += p.vr;
          ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.r);
          ctx.fillStyle = p.c; ctx.fillRect(-p.s / 2, -p.s / 4, p.s, p.s / 2); ctx.restore();
        });
        raf = parts.length ? requestAnimationFrame(tick) : 0;
        if (!raf) ctx.clearRect(0, 0, cv.width, cv.height);
      }
      function celebrate() {
        addScore(1);
        if (!reduce) burst();
      }

      function addScore(pts) {
        count += pts;
        var s = $('nf-score');
        s.hidden = false;
        s.textContent = d.score + count;
        s.classList.remove('score-pop');
        // trigger reflow for css animation
        void s.offsetWidth;
        s.classList.add('score-pop');
      }

      // Physics & Collision System for Draggable Objects
      var justDragged = false;
      var bodies = []; // { el, ox, oy, vx, vy, isDragging, sx, sy, moved }

      function registerBody(el) {
        var body = {
          el: el,
          ox: 0,
          oy: 0,
          vx: 0,
          vy: 0,
          isDragging: false,
          sx: 0,
          sy: 0,
          moved: false,
          lastX: 0,
          lastY: 0,
          lastT: 0,
          hitCooldown: 0
        };

        el.addEventListener('pointerdown', function (e) {
          body.sx = e.clientX - body.ox;
          body.sy = e.clientY - body.oy;
          body.moved = false;
          body.isDragging = true;
          body.vx = 0;
          body.vy = 0;
          body.lastX = e.clientX;
          body.lastY = e.clientY;
          body.lastT = performance.now();
          el.setPointerCapture(e.pointerId);
          el.classList.add('is-dragging');
        });

        el.addEventListener('pointermove', function (e) {
          if (!body.isDragging) return;
          var nx = e.clientX - body.sx;
          var ny = e.clientY - body.sy;
          if (Math.abs(nx - body.ox) + Math.abs(ny - body.oy) > 3) body.moved = true;

          var now = performance.now();
          var dt = Math.max(1, now - body.lastT);
          body.vx = (e.clientX - body.lastX) / dt * 16;
          body.vy = (e.clientY - body.lastY) / dt * 16;
          body.lastX = e.clientX;
          body.lastY = e.clientY;
          body.lastT = now;

          body.ox = nx;
          body.oy = ny;
          el.style.translate = body.ox + 'px ' + body.oy + 'px';
        });

        function end(e) {
          if (el.hasPointerCapture(e.pointerId)) el.releasePointerCapture(e.pointerId);
          body.isDragging = false;
          el.classList.remove('is-dragging');
          if (body.moved) {
            justDragged = true;
            setTimeout(function () { justDragged = false; }, 0);
          }
        }

        el.addEventListener('pointerup', end);
        el.addEventListener('pointercancel', end);
        el.addEventListener('dblclick', function () {
          body.ox = 0;
          body.oy = 0;
          body.vx = 0;
          body.vy = 0;
          el.style.translate = '';
        });

        bodies.push(body);
        return body;
      }

      // 隨機初始角色（0: 科技機器人, 1: 經典太空人, 2: Google Android）
      var charIndex = Math.floor(Math.random() * 3);
      function updateCharDisplay() {
        var r = $('char-robot'), a = $('char-astronaut'), g = $('char-android');
        if (r && a && g) {
          r.style.display = charIndex === 0 ? 'block' : 'none';
          a.style.display = charIndex === 1 ? 'block' : 'none';
          g.style.display = charIndex === 2 ? 'block' : 'none';
        }
      }
      updateCharDisplay();

      function toggleCharacter() {
        charIndex = (charIndex + 1) % 3;
        updateCharDisplay();
      }

      registerBody($('nf-astro'));
      registerBody($('nf-avatar'));
      registerBody($('nf-code'));

      $('nf-astro').addEventListener('click', function () {
        if (!justDragged) {
          toggleCharacter(); // 點擊時循環切換造型
          celebrate();
        }
      });
      $('nf-avatar').addEventListener('click', function () { if (!justDragged) celebrate(); });

      // Collision loop with simple circle/box approximation
      function physicsTick() {
        requestAnimationFrame(physicsTick);

        // 1. Update positions & boundary recovery
        var pad = 10;
        var targetX = window.innerWidth * 0.22; // 左側 (Left)
        var targetY = window.innerHeight * 0.32; // 中上區域 (Upper-Mid area: 左中上)

        for (var i = 0; i < bodies.length; i++) {
          var b = bodies[i];
          if (!b.isDragging) {
            var rect = b.el.getBoundingClientRect();
            var cx = rect.left + rect.width / 2;
            var cy = rect.top + rect.height / 2;

            // 檢查是否完全或大部分脫離可視視窗 (超出邊界)
            var isOffscreen = (rect.right < pad || rect.left > window.innerWidth - pad ||
                               rect.bottom < pad || rect.top > window.innerHeight - pad);

            // 撞擊邊緣計分判斷 (當物件具備速度並觸碰或衝出螢幕邊緣)
            var now = performance.now();
            var speed = Math.hypot(b.vx, b.vy);
            if (speed > 1.2 && now - b.hitCooldown > 350) {
              var hitWall = (rect.left <= 0 || rect.right >= window.innerWidth ||
                             rect.top <= 0 || rect.bottom >= window.innerHeight);
              if (hitWall || isOffscreen) {
                b.hitCooldown = now;
                addScore(1);
              }
            }

            if (isOffscreen) {
              b.recovering = true;
            }

            if (b.recovering) {
              // 慢慢平滑地漂浮導向「左中上位置」
              var toTargetX = targetX - cx;
              var toTargetY = targetY - cy;
              var distToTarget = Math.hypot(toTargetX, toTargetY);

              // 溫柔平緩的失重浮力加速度
              b.vx += (toTargetX / distToTarget) * 0.35;
              b.vy += (toTargetY / distToTarget) * 0.35;
              b.vx *= 0.90; // 高阻尼避免劇烈晃動
              b.vy *= 0.90;

              // 當已經安全浮回左中上區域附近，結束 recovery 狀態交還自由慣性
              if (distToTarget < 80) {
                b.recovering = false;
              }
            }

            if (Math.abs(b.vx) > 0.05 || Math.abs(b.vy) > 0.05) {
              b.ox += b.vx;
              b.oy += b.vy;
              if (!b.recovering) {
                b.vx *= 0.94; // normal friction
                b.vy *= 0.94;
              }
              b.el.style.translate = b.ox.toFixed(2) + 'px ' + b.oy.toFixed(2) + 'px';
            } else {
              b.vx = 0;
              b.vy = 0;
            }
          } else {
            b.recovering = false;
          }
        }

        // 2. Pairwise collision check
        for (var i = 0; i < bodies.length; i++) {
          for (var j = i + 1; j < bodies.length; j++) {
            var b1 = bodies[i], b2 = bodies[j];
            var r1 = b1.el.getBoundingClientRect();
            var r2 = b2.el.getBoundingClientRect();

            var c1x = r1.left + r1.width / 2;
            var c1y = r1.top + r1.height / 2;
            var c2x = r2.left + r2.width / 2;
            var c2y = r2.top + r2.height / 2;

            var dx = c2x - c1x;
            var dy = c2y - c1y;
            var dist = Math.hypot(dx, dy);
            // Effective radius calculation
            var minR = (Math.min(r1.width, r1.height) + Math.min(r2.width, r2.height)) * 0.44;

            if (dist < minR && dist > 0) {
              var overlap = minR - dist;
              var nx = dx / dist;
              var ny = dy / dist;

              // Elastic push & rebound
              if (b1.isDragging && !b2.isDragging) {
                b2.ox += nx * overlap;
                b2.oy += ny * overlap;
                b2.vx = nx * Math.max(Math.hypot(b1.vx, b1.vy), 6) * 1.2;
                b2.vy = ny * Math.max(Math.hypot(b1.vx, b1.vy), 6) * 1.2;
                b2.el.style.translate = b2.ox.toFixed(2) + 'px ' + b2.oy.toFixed(2) + 'px';
              } else if (!b1.isDragging && b2.isDragging) {
                b1.ox -= nx * overlap;
                b1.oy -= ny * overlap;
                b1.vx = -nx * Math.max(Math.hypot(b2.vx, b2.vy), 6) * 1.2;
                b1.vy = -ny * Math.max(Math.hypot(b2.vx, b2.vy), 6) * 1.2;
                b1.el.style.translate = b1.ox.toFixed(2) + 'px ' + b1.oy.toFixed(2) + 'px';
              } else if (!b1.isDragging && !b2.isDragging) {
                b1.ox -= nx * (overlap * 0.5);
                b1.oy -= ny * (overlap * 0.5);
                b2.ox += nx * (overlap * 0.5);
                b2.oy += ny * (overlap * 0.5);

                var relVx = b1.vx - b2.vx;
                var relVy = b1.vy - b2.vy;
                var impulse = (relVx * nx + relVy * ny) * 1.1;
                b1.vx -= impulse * nx;
                b1.vy -= impulse * ny;
                b2.vx += impulse * nx;
                b2.vy += impulse * ny;

                b1.el.style.translate = b1.ox.toFixed(2) + 'px ' + b1.oy.toFixed(2) + 'px';
                b2.el.style.translate = b2.ox.toFixed(2) + 'px ' + b2.oy.toFixed(2) + 'px';
              }
            }
          }
        }
      }

      physicsTick();
    })();
  </script>

