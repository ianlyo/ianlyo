---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { sortPosts, readingTime, relatedPosts, formatDate, slugify } from '../../utils/blog';
import { t } from '../../i18n/ui';
import { SITE } from '../../config/site';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('blog'));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const ui = t('zh-Hant').blog;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const related = relatedPosts(post, all);
const d = post.data;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { '@type': 'Person', name: SITE.author, url: SITE.github.profileUrl },
  keywords: d.tags.join(', '),
  inLanguage: d.lang,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<Base title={d.title} description={d.description} type="article" publishedTime={d.pubDate}
  image={d.cover ?? SITE.ogImage} imageAlt={d.coverAlt ?? d.title} jsonLd={jsonLd} lang={d.lang} altPath={null}>
  <main class="page">
    <div class="container">
      <div class:list={['article-layout', { 'has-toc': toc.length >= 3 }]}>
        <article data-pagefind-body>
          <header class="mb-4">
            <a class="chip mb-2 d-inline-flex align-items-center gap-1" href={`/blog/category/${slugify(d.category)}/`}>
              <span class="material-symbols-rounded icon-xs" aria-hidden="true">folder_open</span>
              <span>{d.category}</span>
            </a>
            <h1 style="font-weight:800;letter-spacing:-.02em">{d.title}</h1>
            <div class="meta">
              <time datetime={d.pubDate.toISOString()} class="d-inline-flex align-items-center gap-1">
                <span class="material-symbols-rounded icon-xs" aria-hidden="true">calendar_today</span>
                <span>{formatDate(d.pubDate, d.lang)}</span>
              </time>
              {d.updatedDate && (
                <span class="d-inline-flex align-items-center gap-1">
                  <span class="material-symbols-rounded icon-xs" aria-hidden="true">update</span>
                  <span>{ui.updated} {formatDate(d.updatedDate, d.lang)}</span>
                </span>
              )}
              <span class="d-inline-flex align-items-center gap-1">
                <span class="material-symbols-rounded icon-xs" aria-hidden="true">schedule</span>
                <span>{readingTime(post.body)} {ui.readingTime}</span>
              </span>
            </div>
            <div class="chip-row mt-2" data-pagefind-ignore>
              {d.tags.map((tg) => (
                <a class="chip chip-muted d-inline-flex align-items-center gap-1" href={`/blog/tag/${slugify(tg)}/`}>
                  <span class="material-symbols-rounded icon-xs" aria-hidden="true">tag</span>
                  <span>{tg}</span>
                </a>
              ))}
            </div>
          </header>
          <div class="prose"><Content /></div>
        </article>
        {toc.length >= 3 && (
          <aside class="toc d-none d-lg-block" data-pagefind-ignore>
            <h2 class="d-flex align-items-center gap-1">
              <span class="material-symbols-rounded icon-sm" aria-hidden="true">format_list_bulleted</span>
              <span>{ui.toc}</span>
            </h2>
            <ul>{toc.map((h) => <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
          </aside>
        )}
      </div>
      {related.length > 0 && (
        <section class="section-block page-narrow" data-pagefind-ignore>
          <h2 class="block-title">
            <span class="material-symbols-rounded text-accent" aria-hidden="true">recommend</span>
            <span>{ui.related}</span>
          </h2>
          <div class="d-grid gap-3">{related.map((p) => <PostCard post={p} />)}</div>
        </section>
      )}
    </div>
  </main>
</Base>
