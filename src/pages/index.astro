---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import { t } from '../i18n/ui';
const ui = t('zh-Hant');
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'ianlyo', url: 'https://linnu.dpdns.org/', inLanguage: 'zh-Hant' },
